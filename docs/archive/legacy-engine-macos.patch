diff --git a/src/WallpaperEngine/Render/CFBO.mm b/src/WallpaperEngine/Render/CFBO.mm
new file mode 100644
index 0000000..9734d3a
--- /dev/null
+++ b/src/WallpaperEngine/Render/CFBO.mm
@@ -0,0 +1,50 @@
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#include "CFBO.h"
+#include "WallpaperEngine/Render/Drivers/CMetalDriver.h"
+#include "WallpaperEngine/Logging/Log.h"
+
+using namespace WallpaperEngine::Render;
+using namespace WallpaperEngine::Render::Drivers;
+
+void CFBO::initMetal (uint32_t textureWidth, uint32_t textureHeight) {
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) {
+        sLog.error ("CFBO::initMetal: no CMetalDriver instance — cannot allocate MTLTexture for '", m_name, "'");
+        return;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+
+    MTLTextureDescriptor* desc = [MTLTextureDescriptor
+        texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                     width:textureWidth
+                                    height:textureHeight
+                                 mipmapped:NO];
+    desc.usage       = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    desc.storageMode = MTLStorageModePrivate;
+
+    id<MTLTexture> tex = [device newTextureWithDescriptor:desc];
+    if (!tex) {
+        sLog.error ("CFBO::initMetal: [MTLDevice newTextureWithDescriptor:] returned nil for '", m_name, "'");
+        return;
+    }
+
+#if !NDEBUG
+    tex.label = [NSString stringWithUTF8String:m_name.c_str ()];
+#endif
+
+    // Retain manually; released in destroyMetal().
+    m_metalTexture = (__bridge_retained void*)tex;
+}
+
+void CFBO::destroyMetal () {
+    if (m_metalTexture) {
+        // Transfer ownership back to ARC so it releases the texture.
+        (void)(__bridge_transfer id<MTLTexture>)m_metalTexture;
+        m_metalTexture = nullptr;
+    }
+}
+
+void* CFBO::getMetalTexture () const { return m_metalTexture; }
+#endif // __APPLE__
