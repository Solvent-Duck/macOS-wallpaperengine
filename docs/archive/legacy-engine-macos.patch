new file mode 100644
index 0000000..5bdcd9d
--- /dev/null
+++ b/CMakeLists-bridge.cmake
@@ -0,0 +1,23 @@
+cmake_minimum_required(VERSION 3.12)
+project(wallpaperengine-vendored-deps C CXX)
+
+# ENGINE_SOURCE_DIR must be set to the linux-wallpaperengine source root
+if(NOT ENGINE_SOURCE_DIR)
+    set(ENGINE_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
+endif()
+
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+
+# ── Vendored dependency builds ───────────────────────────────────────────────
+# These produce the static libraries that CShaderCompiler and CScriptHost link
+# against via SPM linkerSettings (-lglslang, -lspirv-cross-core, -lqjs, etc.).
+
+set(ENABLE_OPT OFF)
+set(SPIRV_CROSS_FORCE_PIC ON)
+set(QJS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+
+add_subdirectory(${ENGINE_SOURCE_DIR}/src/External/glslang-WallpaperEngine glslang)
+add_subdirectory(${ENGINE_SOURCE_DIR}/src/External/SPIRV-Cross-WallpaperEngine spirv-cross)
+add_subdirectory(${ENGINE_SOURCE_DIR}/src/External/quickjs quickjs)
diff --git a/extract_pkg.py b/extract_pkg.py
new file mode 100644
index 0000000..573e4a7
--- /dev/null
+++ b/extract_pkg.py
@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+"""
+Wallpaper Engine scene.pkg extractor and analyzer.
+
+Format (PKGV0021):
+  4 bytes: magic_len (= 8)
+  8 bytes: magic string "PKGV0021"
+  4 bytes: num_files (uint32 LE)
+  For each file:
+    4 bytes: name_len (uint32 LE)
+    name_len bytes: filename (utf-8)
+    4 bytes: data_offset (uint32 LE, relative to end of file table)
+    4 bytes: data_size (uint32 LE)
+  [File table ends here; all file data follows contiguously]
+"""
+
+import struct
+import json
+
+PKG_PATH = "/Users/isaiahbergstrom/Wallpaper Projects/3340296712/scene.pkg"
+
+
+def parse_pkg(data):
+    magic_len = struct.unpack_from('<I', data, 0)[0]
+    magic = data[4:4 + magic_len]
+    pos = 4 + magic_len
+
+    num_files = struct.unpack_from('<I', data, pos)[0]
+    pos += 4
+
+    entries = {}
+    for _ in range(num_files):
+        name_len = struct.unpack_from('<I', data, pos)[0]
+        pos += 4
+        name = data[pos:pos + name_len].decode('utf-8')
+        pos += name_len
+        offset = struct.unpack_from('<I', data, pos)[0]
+        pos += 4
+        size = struct.unpack_from('<I', data, pos)[0]
+        pos += 4
+        entries[name] = (offset, size)
+
+    data_base = pos  # all offsets relative to here
+    return magic, entries, data_base
+
+
+def extract_file(data, entries, data_base, name):
+    if name not in entries:
+        return None
+    offset, size = entries[name]
+    start = data_base + offset
+    return data[start:start + size]
+
+
+def main():
+    with open(PKG_PATH, 'rb') as f:
+        data = f.read()
+
+    magic, entries, data_base = parse_pkg(data)
+
+    print(f"PKG Magic   : {magic.decode()}")
+    print(f"Total files : {len(entries)}")
+    print(f"File size   : {len(data):,} bytes")
+    print(f"Data base   : byte {data_base} (end of file table)")
+    print()
+
+    print("=== Embedded file listing ===")
+    for name, (off, sz) in sorted(entries.items()):
+        print(f"  {name:<60}  offset={off:>10,}  size={sz:>10,}")
+    print()
+
+    # ------------------------------------------------------------------ #
+    # Extract and parse scene.json
+    # ------------------------------------------------------------------ #
+    scene_bytes = extract_file(data, entries, data_base, 'scene.json')
+    if scene_bytes is None:
+        print("ERROR: scene.json not found in pkg!")
+        return
+
+    print(f"=== scene.json ({len(scene_bytes):,} bytes) ===")
+    scene = json.loads(scene_bytes.decode('utf-8'))
+
+    # ------------------------------------------------------------------ #
+    # Find 'Fondo 5' layer and all foliagesway effects within it
+    # ------------------------------------------------------------------ #
+    def find_all(obj, predicate, path=""):
+        """DFS – returns list of (path, obj) for every node matching predicate."""
+        results = []
+        if predicate(obj, path):
+            results.append((path, obj))
+        if isinstance(obj, dict):
+            for k, v in obj.items():
+                results.extend(find_all(v, predicate, f"{path}/{k}"))
+        elif isinstance(obj, list):
+            for i, item in enumerate(obj):
+                results.extend(find_all(item, predicate, f"{path}[{i}]"))
+        return results
+
+    # Find Fondo 5 layer(s)
+    def is_fondo5(obj, path):
+        return isinstance(obj, dict) and isinstance(obj.get('name'), str) and \
+               'fondo 5' in obj['name'].lower()
+
+    fondo5_layers = find_all(scene, is_fondo5)
+    print(f"\nFound {len(fondo5_layers)} layer(s) named 'Fondo 5':")
+    for path, layer in fondo5_layers:
+        print(f"\n--- Layer path: {path} ---")
+        # Show top-level keys of this layer object
+        for k, v in layer.items():
+            if k == 'effects':
+                print(f"  effects: [{len(v)} items]")
+            elif isinstance(v, (str, int, float, bool, type(None))):
+                print(f"  {k}: {v!r}")
+            elif isinstance(v, list):
+                print(f"  {k}: [list of {len(v)}]")
+            elif isinstance(v, dict):
+                print(f"  {k}: {{dict, keys={list(v.keys())[:8]}}}")
+
+    # ------------------------------------------------------------------ #
+    # Find ALL foliagesway effect instances in the entire scene
+    # ------------------------------------------------------------------ #
+    def is_foliagesway(obj, path):
+        if not isinstance(obj, dict):
+            return False
+        # could be an effect entry with 'file' pointing to foliagesway
+        file_val = str(obj.get('file', ''))
+        name_val = str(obj.get('name', ''))
+        return 'foliagesway' in file_val.lower() or 'foliagesway' in name_val.lower()
+
+    all_fsway = find_all(scene, is_foliagesway)
+    print(f"\n\n=== All foliagesway effect instances ({len(all_fsway)} total) ===")
+    for path, eff in all_fsway:
+        print(f"\n[Path: {path}]")
+        print(json.dumps(eff, indent=2))
+
+    # ------------------------------------------------------------------ #
+    # Specifically dump Fondo 5's effects section
+    # ------------------------------------------------------------------ #
+    for path, layer in fondo5_layers:
+        effects = layer.get('effects', [])
+        print(f"\n\n=== 'Fondo 5' effects ({len(effects)} total) ===")
+        for i, eff in enumerate(effects):
+            print(f"\n  -- Effect [{i}] --")
+            print(json.dumps(eff, indent=4))
+
+    # ------------------------------------------------------------------ #
+    # Highlight foliagesway constants with value > 1
+    # ------------------------------------------------------------------ #
+    print("\n\n=== Foliagesway constant values (all instances) ===")
+    interesting_keys = {'strength', 'scale', 'speed', 'ratio', 'intensity',
+                        'amplitude', 'frequency', 'amount', 'weight'}
+
+    for path, eff in all_fsway:
+        print(f"\n[{path}]")
+        combos = eff.get('combos', {})
+        constants = eff.get('constants', eff.get('properties', {}))
+        if combos:
+            print(f"  combos: {json.dumps(combos)}")
+        if constants:
+            print(f"  constants/properties: {json.dumps(constants, indent=4)}")
+        # Also check nested 'passes' or 'material'
+        for sub_key in ('passes', 'material', 'materials'):
+            sub = eff.get(sub_key)
+            if sub:
+                print(f"  {sub_key}: {json.dumps(sub, indent=4)}")
+
+    # ------------------------------------------------------------------ #
+    # Also show foliagesway effect definition from effects/ directory
+    # ------------------------------------------------------------------ #
+    effect_json_bytes = extract_file(data, entries, data_base, 'effects/foliagesway/effect.json')
+    if effect_json_bytes:
+        print("\n\n=== effects/foliagesway/effect.json (effect definition) ===")
+        print(effect_json_bytes.decode('utf-8'))
+
+    mat_json_bytes = extract_file(data, entries, data_base, 'materials/effects/foliagesway.json')
+    if mat_json_bytes:
+        print("\n\n=== materials/effects/foliagesway.json ===")
+        print(mat_json_bytes.decode('utf-8'))
+
+
+if __name__ == '__main__':
+    main()
