+void ShaderUnit::sanitizeConditionals () {
+    std::string sanitized;
+    sanitized.reserve (this->m_preprocessed.size ());
+
+    int openConditionals = 0;
+    size_t start = 0;
+
+    while (start <= this->m_preprocessed.size ()) {
+        const size_t end = this->m_preprocessed.find ('\n', start);
+        const bool hasNewline = end != std::string::npos;
+        const std::string line
+            = this->m_preprocessed.substr (start, hasNewline ? (end - start) : std::string::npos);
+
+        size_t first = line.find_first_not_of (" \t\r");
+        const std::string_view trimmed
+            = (first == std::string::npos) ? std::string_view {} : std::string_view (line).substr (first);
+
+        const bool isIf
+            = trimmed.rfind ("#if", 0) == 0
+              && trimmed.rfind ("#ifdef", 0) != 0
+              && trimmed.rfind ("#ifndef", 0) != 0;
+        const bool isIfdef = trimmed.rfind ("#ifdef", 0) == 0 || trimmed.rfind ("#ifndef", 0) == 0;
+        const bool isEndif = trimmed.rfind ("#endif", 0) == 0;
+
+        if (isEndif && openConditionals == 0) {
+            sLog.error ("ShaderUnit::sanitizeConditionals: removed orphan #endif in ", this->m_file);
+        } else {
+            sanitized += line;
+            if (hasNewline) {
+                sanitized.push_back ('\n');
+            }
+        }
+
+        if (isIf || isIfdef) {
+            ++openConditionals;
+        } else if (isEndif && openConditionals > 0) {
+            --openConditionals;
+        }
+
+        if (!hasNewline) {
+            break;
+        }
+        start = end + 1;
+    }
+
+    while (openConditionals-- > 0) {
+        sanitized += "\n#endif\n";
+        sLog.error ("ShaderUnit::sanitizeConditionals: appended missing #endif in ", this->m_file);
+    }
+
+    this->m_preprocessed = std::move (sanitized);
+}
+
+void ShaderUnit::sanitizeFragmentVaryings () {
+    if (this->m_type != GLSLContext::UnitType_Fragment) {
+        return;
+    }
+
+    static const std::regex varyingRegex (R"(^\s*varying\s+([A-Za-z_][A-Za-z0-9_]*)\s+([A-Za-z_][A-Za-z0-9_]*)\s*;\s*$)");
+    static const std::regex mainRegex (R"(void\s+main\s*\(\s*\)\s*\{)");
+
+    std::smatch match;
+    std::stringstream stream (this->m_preprocessed);
+    std::string line;
+    std::vector<std::pair<std::string, std::string>> varyings;
+
+    while (std::getline (stream, line)) {
+        if (std::regex_match (line, match, varyingRegex)) {
+            varyings.emplace_back (match[2].str (), match[1].str ());
+        }
+    }
+
+    if (varyings.empty ()) {
+        return;
+    }
+
+    const size_t mainPos = this->m_preprocessed.find ("void main");
+    if (mainPos == std::string::npos) {
+        return;
+    }
+
+    const std::string mainBody = this->m_preprocessed.substr (mainPos);
+    std::vector<std::pair<std::string, std::string>> mutatedVaryings;
+    std::set<std::string> seen;
+
+    for (const auto& [name, type] : varyings) {
+        const std::regex assignRegex ("(^|[^A-Za-z0-9_])" + name + R"(\s*=)", std::regex::multiline);
+        if (std::regex_search (mainBody, assignRegex) && seen.insert (name).second) {
+            mutatedVaryings.emplace_back (name, type);
+        }
+    }
+
+    if (mutatedVaryings.empty ()) {
+        return;
+    }
+
+    std::smatch mainMatch;
+    if (!std::regex_search (this->m_preprocessed, mainMatch, mainRegex)) {
+        return;
+    }
+
+    const size_t bracePos = mainMatch.position (0) + mainMatch.length (0);
+    std::string prologue;
+    for (const auto& [name, type] : mutatedVaryings) {
+        const std::string localName = "_we_mut_" + name;
+        prologue += "\n    " + type + " " + localName + " = " + name + ";";
+        prologue += "\n#define " + name + " " + localName;
+    }
+    prologue += "\n";
+
+    this->m_preprocessed.insert (bracePos, prologue);
+}
