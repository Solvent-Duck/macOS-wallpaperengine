 namespace WallpaperEngine::Audio::Drivers::Recorders {
+
 void PlaybackRecorder::update () { }
 
+void PlaybackRecorder::injectBands (const float* src, int count) {
+    if (!src || count <= 0)
+        return;
+
+    // Resample src[0..count-1] into a target array of dstLen bands by
+    // averaging the corresponding contiguous slice of the source.
+    auto resample = [&] (float* dst, int dstLen) {
+        for (int i = 0; i < dstLen; ++i) {
+            const int lo = i * count / dstLen;
+            const int hi = std::min ((i + 1) * count / dstLen, count);
+            if (lo >= hi) {
+                dst[i] = src[std::min (lo, count - 1)];
+                continue;
+            }
+            float sum = 0.0f;
+            for (int j = lo; j < hi; ++j)
+                sum += src[j];
+            dst[i] = sum / static_cast<float> (hi - lo);
+        }
+    };
+
+    resample (audio16, 16);
+    resample (audio32, 32);
+    resample (audio64, 64);
+}
+
 } // namespace WallpaperEngine::Audio::Drivers::Recorders
