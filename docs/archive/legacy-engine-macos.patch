diff --git a/src/WallpaperEngine/Render/Drivers/Output/MetalOutput.h b/src/WallpaperEngine/Render/Drivers/Output/MetalOutput.h
new file mode 100644
index 0000000..01c9493
--- /dev/null
+++ b/src/WallpaperEngine/Render/Drivers/Output/MetalOutput.h
@@ -0,0 +1,34 @@
+#pragma once
+#ifdef __APPLE__
+
+#include "Output.h"
