+// ─────────────────────────────────────────────────────────────────────────────
+
+GLSLContext::MSLOutput GLSLContext::toMsl (const std::string& vertex, const std::string& fragment) {
+    // ── Vertex shader ────────────────────────────────────────────────────────
+    glslang::TShader vertexShader (EShLangVertex);
+    const char* vertexSource = vertex.c_str ();
+    vertexShader.setStrings (&vertexSource, 1);
+    vertexShader.setEntryPoint ("main");
+    vertexShader.setEnvInput (glslang::EShSourceGlsl, EShLangVertex, glslang::EShClientOpenGL, 330);
+    vertexShader.setEnvClient (glslang::EShClientOpenGL, glslang::EShTargetOpenGL_450);
+    vertexShader.setEnvTarget (glslang::EShTargetSpv, glslang::EShTargetSpv_1_5);
+    vertexShader.setAutoMapLocations (true);
+    vertexShader.setAutoMapBindings (true);
+
+    if (!vertexShader.parse (&BuiltInResource, 100, false, EShMsgDefault)) {
+        sLog.error ("MSL vertex unit parsing failed: ", vertexShader.getInfoLog ());
+        return {};
+    }
+
+    // ── Fragment shader ──────────────────────────────────────────────────────
+    glslang::TShader fragmentShader (EShLangFragment);
+    const char* fragmentSource = fragment.c_str ();
+    fragmentShader.setStrings (&fragmentSource, 1);
+    fragmentShader.setEntryPoint ("main");
+    fragmentShader.setEnvInput (glslang::EShSourceGlsl, EShLangFragment, glslang::EShClientOpenGL, 330);
+    fragmentShader.setEnvClient (glslang::EShClientOpenGL, glslang::EShTargetOpenGL_450);
+    fragmentShader.setEnvTarget (glslang::EShTargetSpv, glslang::EShTargetSpv_1_5);
+    fragmentShader.setAutoMapLocations (true);
+    fragmentShader.setAutoMapBindings (true);
+
+    if (!fragmentShader.parse (&BuiltInResource, 100, false, EShMsgDefault)) {
+        sLog.error ("MSL fragment unit parsing failed: ", fragmentShader.getInfoLog ());
+        return {};
+    }
+
+    // ── Link ─────────────────────────────────────────────────────────────────
+    glslang::TProgram program;
+    program.addShader (&vertexShader);
+    program.addShader (&fragmentShader);
+
+    if (!program.link (EShMsgDefault)) {
+        sLog.error ("MSL program linking failed: ", program.getInfoLog ());
+        return {};
+    }
+
+    // ── MSL options ──────────────────────────────────────────────────────────
+    // enable_decoration_binding = false (the default): SPIRV-Cross auto-assigns
+    // unique [[buffer(N)]], [[texture(N)]], [[sampler(N)]] indices for all resources.
+    // Binding decorations from the SPIR-V (which all default to 0 for OpenGL GLSL
+    // without explicit layout(binding=N)) are NOT used, so there are no slot collisions.
+    // Actual slot assignments are reflected by parsing the generated MSL signature.
+    spirv_cross::CompilerMSL::Options mslOpts;
+    mslOpts.platform   = spirv_cross::CompilerMSL::Options::macOS;
+    mslOpts.msl_version = spirv_cross::CompilerMSL::Options::make_msl_version (2, 0);
+    // enable_decoration_binding left as false (default)
+
+    // ── Vertex SPIR-V → MSL ──────────────────────────────────────────────────
+    std::vector<uint32_t> spirv;
+    glslang::GlslangToSpv (*program.getIntermediate (EShLangVertex), spirv);
+
+    spirv_cross::CompilerMSL vertComp (spirv);
+    vertComp.set_msl_options (mslOpts);
+
+    // WE GLSL shaders declare vertex attributes by name without layout(location=N).
+    // glslang may not emit Location decorations in the SPIR-V for the OpenGL target,
+    // so SPIRV-Cross won't generate [[attribute(N)]] on the main0_in struct members.
+    // We sort inputs alphabetically (deterministic), assign consecutive Location
+    // decorations, and record the vertex attribute layout for the MTLVertexDescriptor.
+    // Vertex data buffers start at kVertexDataBaseSlot (28) so they never collide
+    // with the auto-assigned uniform buffer slots (0, 1, 2, …) in the same stage.
+    MSLOutput out;
+    {
+        // Only process stage inputs that are actually read by the shader.
+        // SPIRV-Cross omits unused inputs from the MSL struct (e.g. a_TexCoordVec4C1
+        // when GS_ENABLED=0 / THICKFORMAT=1 — declared but never referenced), so
+        // assigning locations and injecting [[attribute(N)]] for them is wrong.
+        const auto activeVars = vertComp.get_active_interface_variables ();
+
+        auto stageInputs = vertComp.get_shader_resources ().stage_inputs;
+        // Remove inputs that are not actively read.
+        stageInputs.erase (
+            std::remove_if (stageInputs.begin (), stageInputs.end (),
+                            [&] (const spirv_cross::Resource& r) {
+                                return activeVars.find (r.id) == activeVars.end ();
+                            }),
+            stageInputs.end ());
+
+        std::sort (stageInputs.begin (), stageInputs.end (),
+                   [] (const spirv_cross::Resource& a, const spirv_cross::Resource& b) {
+                       return a.name < b.name;
+                   });
+
+        uint32_t nextLoc = 0;
+        for (const auto& inp : stageInputs) {
+            vertComp.set_decoration (inp.id, spv::DecorationLocation, nextLoc);
+            const auto& type   = vertComp.get_type (inp.type_id);
+            uint32_t    bufIdx = kVertexDataBaseSlot + nextLoc;
+            out.vertexAttributes.push_back ({inp.name, nextLoc, type.vecsize, bufIdx});
+            ++nextLoc;
+        }
+    }
+
+    out.vertexMSL = vertComp.compile ();
+
+    // Inject [[attribute(N)]] into the main0_in struct members if SPIRV-Cross did
+    // not emit them (set_decoration on stage_input IDs does not always take effect
+    // through the emission pipeline; post-process the MSL text as a reliable fallback).
+    // We match "NAME;" which only occurs as a struct member declaration, not in field
+    // accesses like "in.NAME".
+    for (const auto& attr : out.vertexAttributes) {
+        if (out.vertexMSL.find (attr.name + " [[attribute(") != std::string::npos)
+            continue; // already present
+        const std::string from = attr.name + ";";
+        const std::string to   = attr.name + " [[attribute(" + std::to_string (attr.location) + ")]];";
+        const size_t pos = out.vertexMSL.find (from);
+        if (pos != std::string::npos)
+            out.vertexMSL.replace (pos, from.size (), to);
+        // else: attribute declared but not actively used (e.g. a_TexCoordVec4C1 when
+        // GS_ENABLED=0) — SPIRV-Cross omits it from main0_in, which is correct.
+    }
+
+    // Reflect vertex-stage uniform buffer slots from the generated MSL signature.
+    {
+        std::map<std::string, uint32_t> dummy;
+        parseMSLSignatureSlots (out.vertexMSL, out.vertexUniformSlots, dummy, dummy);
+    }
+    compactBufferSlots (out.vertexMSL, out.vertexUniformSlots, kVertexDataBaseSlot);
+
+    // Fix address-space mismatch in helper functions caused by SPIRV-Cross uniform promotion.
+    //
+    // When a helper function (e.g. ComputeParticleTangents) reads a global uniform,
+    // SPIRV-Cross adds the uniform as an explicit function parameter.  It incorrectly
+    // annotates these promoted parameters as `thread const T&` even though the entry
+    // point declares them as `constant T& NAME [[buffer(N)]]`.  Metal rejects the call
+    // because `constant` cannot bind to a `thread` reference parameter.
+    //
+    // Fix: for every uniform name we reflected from the main0 signature, find
+    // every occurrence of `thread const TYPE& UNIFORMNAME` in helper signatures
+    // and replace `thread const ` with `constant `.
+    rewritePromotedUniformAddressSpace (out.vertexMSL, out.vertexUniformSlots);
+
+    // ── Fragment SPIR-V → MSL ────────────────────────────────────────────────
+    spirv.clear ();
+    glslang::GlslangToSpv (*program.getIntermediate (EShLangFragment), spirv);
+
+    spirv_cross::CompilerMSL fragComp (spirv);
+    fragComp.set_msl_options (mslOpts);
+    out.fragmentMSL = fragComp.compile ();
+
+    // Reflect all fragment-stage resource slots from the generated MSL signature.
+    parseMSLSignatureSlots (
+        out.fragmentMSL,
+        out.fragmentUniformSlots,
+        out.fragmentTextureSlots,
+        out.fragmentSamplerSlots);
+    compactBufferSlots (out.fragmentMSL, out.fragmentUniformSlots, 31);
+
+    rewritePromotedUniformAddressSpace (out.fragmentMSL, out.fragmentUniformSlots);
+
+    return out;
+}
