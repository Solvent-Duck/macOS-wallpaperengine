+// ── MSL signature slot parser ────────────────────────────────────────────────
+// Parses "NAME [[tag(N)]]" patterns from the main0() function signature line.
+// Used to extract Metal resource-slot assignments for each uniform, texture, and
+// sampler parameter so they can be bound individually in CPass::renderMetal().
+static void parseMSLSignatureSlots (
+    const std::string&                msl,
+    std::map<std::string, uint32_t>&  bufferSlots,
+    std::map<std::string, uint32_t>&  textureSlots,
+    std::map<std::string, uint32_t>&  samplerSlots)
+{
+    const size_t funcPos = msl.find ("main0(");
+    if (funcPos == std::string::npos)
+        return;
+    // The function signature is always on a single line in SPIRV-Cross output.
+    const size_t lineEnd = msl.find ('\n', funcPos);
+    const std::string sig =
+        msl.substr (funcPos, lineEnd == std::string::npos ? std::string::npos : lineEnd - funcPos);
+
+    auto extract = [&] (const std::string& tag, std::map<std::string, uint32_t>& out) {
+        const std::string marker = "[[" + tag + "(";
+        size_t pos = 0;
+        while ((pos = sig.find (marker, pos)) != std::string::npos) {
+            const size_t numEnd = sig.find (")]", pos + marker.size ());
+            if (numEnd == std::string::npos)
+                break;
+            const uint32_t slot = static_cast<uint32_t> (
+                std::stoul (sig.substr (pos + marker.size (), numEnd - pos - marker.size ())));
+
+            // Scan backwards past whitespace, then grab the identifier.
+            size_t ne = pos;
+            while (ne > 0 && (sig[ne - 1] == ' ' || sig[ne - 1] == '\t'))
+                --ne;
+            size_t ns = ne;
+            while (ns > 0
+                   && (std::isalnum (static_cast<unsigned char> (sig[ns - 1]))
+                       || sig[ns - 1] == '_'))
+                --ns;
+            const std::string name = sig.substr (ns, ne - ns);
+            // Skip built-in parameter names.
+            if (!name.empty () && name != "in" && name != "out" && name != "patchIn")
+                out[name] = slot;
+            pos = numEnd + 2;
+        }
+    };
+
+    extract ("buffer",  bufferSlots);
+    extract ("texture", textureSlots);
+    extract ("sampler", samplerSlots);
+}
+
+static void rewritePromotedUniformAddressSpace (
+    std::string& msl,
+    const std::map<std::string, uint32_t>& uniformSlots
+) {
+    for (const auto& [uniformName, slot] : uniformSlots) {
+        (void)slot;
+        const std::string needle      = "& " + uniformName;
+        const std::string threadConst = "thread const ";
+        const size_t      tcLen       = threadConst.size ();
+        const size_t      replLen     = 9; // "constant ".size()
+        size_t            pos         = 0;
+        while ((pos = msl.find (needle, pos)) != std::string::npos) {
+            size_t lineStart = msl.rfind ('\n', pos);
+            lineStart        = (lineStart == std::string::npos) ? 0 : lineStart + 1;
+            size_t tcPos     = msl.rfind (threadConst, pos - 1);
+            if (tcPos != std::string::npos && tcPos >= lineStart) {
+                msl.replace (tcPos, tcLen, "constant ");
+                pos = (pos - (tcLen - replLen)) + needle.size ();
+            } else {
+                pos += needle.size ();
+            }
+        }
+    }
+}
+
+static void compactBufferSlots (
+    std::string& msl,
+    std::map<std::string, uint32_t>& bufferSlots,
+    uint32_t maxSlotExclusive
+) {
+    if (bufferSlots.empty ()) {
+        return;
+    }
+
+    std::vector<std::pair<std::string, uint32_t>> ordered (bufferSlots.begin (), bufferSlots.end ());
+    std::sort (
+        ordered.begin (),
+        ordered.end (),
+        [] (const auto& lhs, const auto& rhs) {
+            if (lhs.second != rhs.second) {
+                return lhs.second < rhs.second;
+            }
+            return lhs.first < rhs.first;
+        });
+
+    uint32_t nextSlot = 0;
+    for (const auto& [name, oldSlot] : ordered) {
+        if (nextSlot >= maxSlotExclusive) {
+            sLog.error ("GLSLContext::compactBufferSlots: exceeded Metal buffer-slot budget while remapping ", name);
+            break;
+        }
+
+        const std::string oldAttr = name + " [[buffer(" + std::to_string (oldSlot) + ")]]";
+        const std::string newAttr = name + " [[buffer(" + std::to_string (nextSlot) + ")]]";
+
+        size_t pos = 0;
+        while ((pos = msl.find (oldAttr, pos)) != std::string::npos) {
+            msl.replace (pos, oldAttr.size (), newAttr);
+            pos += newAttr.size ();
+        }
+
+        bufferSlots[name] = nextSlot++;
+    }
+}
