diff --git a/src/WallpaperEngine/Render/Objects/CImage.mm b/src/WallpaperEngine/Render/Objects/CImage.mm
new file mode 100644
index 0000000..3b92b25
--- /dev/null
+++ b/src/WallpaperEngine/Render/Objects/CImage.mm
@@ -0,0 +1,56 @@
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#include "CImage.h"
+#include "WallpaperEngine/Render/Drivers/CMetalDriver.h"
+
+using namespace WallpaperEngine::Render::Objects;
+using namespace WallpaperEngine::Render::Drivers;
+
+static void* makeMTLBuffer (id<MTLDevice> device, const float* data, size_t bytes) {
+    id<MTLBuffer> buf = [device newBufferWithBytes:data
+                                           length:bytes
+                                          options:MTLResourceStorageModeShared];
+    return (__bridge_retained void*)buf;
+}
+
+static void releaseMTLBuffer (void*& ptr) {
+    if (ptr) {
+        (void)(__bridge_transfer id<MTLBuffer>)ptr;
+        ptr = nullptr;
+    }
+}
+
+void CImage::setupMetalBuffers (
+    const float* scenePos, size_t sceneSize,
+    const float* copyPos,  size_t copySize,
+    const float* passPos,  size_t passSize,
+    const float* texcoordCopy, size_t texcoordCopySize,
+    const float* texcoordPass, size_t texcoordPassSize
+) {
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) return;
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+
+    m_metalSceneSpacePosition = makeMTLBuffer (device, scenePos, sceneSize);
+    m_metalCopySpacePosition  = makeMTLBuffer (device, copyPos,  copySize);
+    m_metalPassSpacePosition  = makeMTLBuffer (device, passPos,  passSize);
+    m_metalTexcoordCopy       = makeMTLBuffer (device, texcoordCopy, texcoordCopySize);
+    m_metalTexcoordPass       = makeMTLBuffer (device, texcoordPass, texcoordPassSize);
+}
+
+void CImage::destroyMetalBuffers () {
+    releaseMTLBuffer (m_metalSceneSpacePosition);
+    releaseMTLBuffer (m_metalCopySpacePosition);
+    releaseMTLBuffer (m_metalPassSpacePosition);
+    releaseMTLBuffer (m_metalTexcoordCopy);
+    releaseMTLBuffer (m_metalTexcoordPass);
+}
+
+void* CImage::getMetalSceneSpacePosition () const { return m_metalSceneSpacePosition; }
+void* CImage::getMetalCopySpacePosition ()  const { return m_metalCopySpacePosition; }
+void* CImage::getMetalPassSpacePosition ()  const { return m_metalPassSpacePosition; }
+void* CImage::getMetalTexCoordCopy ()       const { return m_metalTexcoordCopy; }
+void* CImage::getMetalTexCoordPass ()       const { return m_metalTexcoordPass; }
+
+#endif // __APPLE__
