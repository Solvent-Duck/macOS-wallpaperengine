+ModelUniquePtr loadModelReference (const JSON& it, const Project& project, const std::string& modelReference) {
+    const auto path = std::filesystem::path (modelReference);
+
+    if (path.extension () == ".json") {
+	return ModelParser::load (project, modelReference);
+    }
+
+    std::optional<std::string> materialPath;
+    try {
+	const std::string modelContents = project.assetLocator->readString (path);
+	const std::string materialPrefix = "materials/";
+	const std::string materialSuffix = ".json";
+	const auto start = modelContents.find (materialPrefix);
+	if (start != std::string::npos) {
+	    const auto end = modelContents.find (materialSuffix, start);
+	    if (end != std::string::npos) {
+		materialPath = modelContents.substr (start, (end - start) + materialSuffix.size ());
+	    }
+	}
+    } catch (const std::exception& error) {
+	sLog.error ("Failed to inspect model reference ", modelReference, ": ", error.what ());
+    }
+
+    JSON descriptor = JSON::object ();
+    auto descriptorPath = path;
+    descriptorPath.replace_extension (".json");
+    try {
+	descriptor = WallpaperEngine::Data::JSON::parseRelaxedJSON (project.assetLocator->readString (descriptorPath));
+    } catch (...) {
+	descriptor = JSON::object ();
+    }
+
+    if (!materialPath.has_value ()) {
+	if (descriptor.contains ("material") && descriptor["material"].is_string ()) {
+	    materialPath = descriptor["material"].get<std::string> ();
+	} else {
+	    throw std::runtime_error ("Model reference missing material descriptor: " + modelReference);
+	}
+    }
+
+    return std::make_unique<ModelStruct> (ModelStruct {
+	.filename = modelReference,
+	.material = MaterialParser::load (project, *materialPath),
+	.solidlayer = descriptor.optional ("solidlayer", false),
+	.fullscreen = descriptor.optional ("fullscreen", false),
+	.passthrough = descriptor.optional ("passthrough", false),
+	.autosize = descriptor.optional ("autosize", false),
+	.nopadding = descriptor.optional ("nopadding", false),
+	.width = descriptor.optional<int> ("width"),
+	.height = descriptor.optional<int> ("height"),
+	.puppet = descriptor.optional<std::string> ("puppet"),
+    });
