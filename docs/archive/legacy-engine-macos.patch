+inline std::string stripTrailingCommas (const std::string& content) {
+    std::string sanitized;
+    sanitized.reserve (content.size ());
+
+    bool inString = false;
+    bool escaped = false;
+
+    for (size_t i = 0; i < content.size (); ++i) {
+        const char ch = content[i];
+
+        if (inString) {
+            sanitized.push_back (ch);
+
+            if (escaped) {
+                escaped = false;
+            } else if (ch == '\\') {
+                escaped = true;
+            } else if (ch == '"') {
+                inString = false;
+            }
+
+            continue;
+        }
+
+        if (ch == '"') {
+            inString = true;
+            sanitized.push_back (ch);
+            continue;
+        }
+
+        if (ch == ',') {
+            size_t lookahead = i + 1;
+            while (lookahead < content.size () && std::isspace (static_cast<unsigned char> (content[lookahead])) != 0) {
+                ++lookahead;
+            }
+
+            if (lookahead < content.size () && (content[lookahead] == ']' || content[lookahead] == '}')) {
+                continue;
+            }
+        }
+
+        sanitized.push_back (ch);
+    }
+
+    return sanitized;
+}
+
+inline JSON parseRelaxedJSON (const std::string& content) {
+    try {
+        return JSON::parse (content);
+    } catch (const std::exception&) {
+        const auto sanitized = stripTrailingCommas (content);
+        if (sanitized != content) {
+            try {
+                return JSON::parse (sanitized);
+            } catch (const std::exception& error) {
+                sLog.error ("parseRelaxedJSON failed after trailing-comma sanitization: ", error.what ());
+                throw;
+            }
+        }
+        throw;
+    }
+}
+
 } // namespace WallpaperEngine::Data::JSON
