diff --git a/src/WallpaperEngine/Render/Drivers/AVFoundation/AVGLPlayer.h b/src/WallpaperEngine/Render/Drivers/AVFoundation/AVGLPlayer.h
new file mode 100644
index 0000000..e5a1b55
--- /dev/null
+++ b/src/WallpaperEngine/Render/Drivers/AVFoundation/AVGLPlayer.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#ifdef __APPLE__
+
+#include <cstddef>
+#include <memory>
+
+namespace WallpaperEngine::Render {
+
+/**
+ * macOS AVFoundation-backed video texture player.
+ *
+ * Decodes an in-memory MP4/video stream using AVPlayer and
+ * AVPlayerItemVideoOutput, uploading frames into an MTLTexture on
+ * every render() call.
+ */
+class AVGLPlayer {
+public:
+    /**
+     * @param videoData  Raw video file bytes (MP4)
+     * @param videoSize  Size of videoData in bytes
+     * @param width      Declared texture width (used for initial allocation)
+     * @param height     Declared texture height
+     */
+    AVGLPlayer (const char* videoData, size_t videoSize,
+                uint32_t width, uint32_t height);
+    ~AVGLPlayer ();
+
+    void setMuted ();
+    void setVolume (float volume);
+    void setUntimed ();        // no-op: AVFoundation manages its own timing
+    void incrementUsageCount ();
+    void decrementUsageCount ();
+    void render ();            // called each frame; uploads new video frame to Metal
+    [[nodiscard]] void* getMetalTexture () const;
+
+private:
+    void* m_impl = nullptr;    // WEVideoPlayer* — defined in the .mm translation unit
+};
+
+using AVGLPlayerUniquePtr = std::unique_ptr<AVGLPlayer>;
+
+} // namespace WallpaperEngine::Render
+
+#endif // __APPLE__
diff --git a/src/WallpaperEngine/Render/Drivers/AVFoundation/AVGLPlayer.mm b/src/WallpaperEngine/Render/Drivers/AVFoundation/AVGLPlayer.mm
new file mode 100644
index 0000000..5d90698
--- /dev/null
+++ b/src/WallpaperEngine/Render/Drivers/AVFoundation/AVGLPlayer.mm
@@ -0,0 +1,256 @@
+#ifdef __APPLE__
+
+#import <AVFoundation/AVFoundation.h>
+#import <CoreMedia/CoreMedia.h>
+#import <CoreVideo/CoreVideo.h>
+#import <Metal/Metal.h>
+
+#include "AVGLPlayer.h"
+#include "WallpaperEngine/Logging/Log.h"
+
+extern "C" void* we_current_metal_device ();
+
+// ---------------------------------------------------------------------------
+// Objective-C implementation class
+// ---------------------------------------------------------------------------
+
+@interface WEVideoPlayer : NSObject
+
+@property (nonatomic, strong) AVPlayer*                  player;
+@property (nonatomic, strong) AVPlayerItem*              playerItem;
+@property (nonatomic, strong) AVPlayerItemVideoOutput*   videoOutput;
+@property (nonatomic, strong) NSString*                  tempFilePath;
+@property (nonatomic, strong) id<MTLTexture>             metalTexture;
+@property (nonatomic, assign) int                        allocatedWidth;
+@property (nonatomic, assign) int                        allocatedHeight;
+@property (nonatomic, assign) int                        usageCount;
+@property (nonatomic, assign) BOOL                       started;
+
+- (instancetype)initWithVideoData:(const char*)data
+                             size:(size_t)size
+                            width:(uint32_t)width
+                           height:(uint32_t)height;
+- (void)play;
+- (void)pause;
+- (void)updateTexture;
+- (id<MTLTexture>)currentMetalTexture;
+
+@end
+
+@implementation WEVideoPlayer
+
+- (BOOL)ensureTextureWithWidth:(uint32_t)width height:(uint32_t)height {
+    void* devicePtr = we_current_metal_device ();
+    if (devicePtr == nullptr) {
+        sLog.error ("AVGLPlayer: no Metal device available for video texture");
+        return NO;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+    if (self.metalTexture != nil
+        && self.allocatedWidth == static_cast<int> (width)
+        && self.allocatedHeight == static_cast<int> (height)) {
+        return YES;
+    }
+
+    MTLTextureDescriptor* descriptor
+        = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                             width:width
+                                                            height:height
+                                                         mipmapped:NO];
+    descriptor.usage = MTLTextureUsageShaderRead;
+    descriptor.storageMode = MTLStorageModeShared;
+
+    id<MTLTexture> texture = [device newTextureWithDescriptor:descriptor];
+    if (texture == nil) {
+        sLog.error ("AVGLPlayer: failed to allocate Metal texture ", static_cast<int> (width), "x",
+                    static_cast<int> (height));
+        return NO;
+    }
+
+    self.metalTexture = texture;
+    self.allocatedWidth = static_cast<int> (width);
+    self.allocatedHeight = static_cast<int> (height);
+    return YES;
+}
+
+- (instancetype)initWithVideoData:(const char*)data
+                             size:(size_t)size
+                            width:(uint32_t)width
+                           height:(uint32_t)height {
+    self = [super init];
+    if (!self) return nil;
+
+    _allocatedWidth  = static_cast<int> (width);
+    _allocatedHeight = static_cast<int> (height);
+    _usageCount      = 0;
+    _started         = NO;
+
+    // Write the raw video bytes to a temporary file so AVFoundation can read them.
+    // A custom AVAssetResourceLoader would avoid the file but adds significant complexity.
+    NSString* tmpDir = NSTemporaryDirectory ();
+    _tempFilePath = [tmpDir stringByAppendingPathComponent:
+                    [NSString stringWithFormat:@"we_video_%p.mp4", (__bridge void*)self]];
+
+    NSData* videoData = [NSData dataWithBytes:data length:size];
+    if (![videoData writeToFile:_tempFilePath atomically:NO]) {
+        sLog.error ("AVGLPlayer: failed to write temp video file to ", _tempFilePath.UTF8String);
+        return nil;
+    }
+
+    NSURL* url = [NSURL fileURLWithPath:_tempFilePath];
+
+    // Request 32-bit BGRA pixel buffers — trivially uploaded to GL as GL_BGRA.
+    NSDictionary* pixelAttrs = @{
+        (id)kCVPixelBufferPixelFormatTypeKey: @(kCVPixelFormatType_32BGRA),
+        (id)kCVPixelBufferIOSurfacePropertiesKey: @{},
+    };
+    _videoOutput = [[AVPlayerItemVideoOutput alloc] initWithPixelBufferAttributes:pixelAttrs];
+
+    _playerItem = [AVPlayerItem playerItemWithURL:url];
+    [_playerItem addOutput:_videoOutput];
+
+    _player = [[AVPlayer alloc] initWithPlayerItem:_playerItem];
+    _player.muted  = YES;
+    _player.volume = 0.0f;
+
+    if (![self ensureTextureWithWidth:width height:height]) {
+        return nil;
+    }
+
+    // Loop seamlessly.
+    __weak typeof(self) weakSelf = self;
+    [[NSNotificationCenter defaultCenter]
+        addObserverForName: AVPlayerItemDidPlayToEndTimeNotification
+                    object: _playerItem
+                     queue: nil
+                usingBlock: ^(NSNotification*) {
+        [weakSelf.player seekToTime:kCMTimeZero completionHandler:^(BOOL) {
+            if (weakSelf.started) [weakSelf.player play];
+        }];
+    }];
+
+    sLog.out ("AVGLPlayer: initialized ", (int)width, "x", (int)height,
+              " video texture (", (int)size, " bytes)");
+    return self;
+}
+
+- (void)dealloc {
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+    [_player pause];
+    if (_tempFilePath) {
+        [[NSFileManager defaultManager] removeItemAtPath:_tempFilePath error:nil];
+    }
+}
+
+- (void)play {
+    _started = YES;
+    [_player play];
+}
+
+- (void)pause {
+    _started = NO;
+    [_player pause];
+}
+
+- (void)updateTexture {
+    CMTime currentTime = _player.currentTime;
+    if (![_videoOutput hasNewPixelBufferForItemTime:currentTime]) return;
+
+    CVPixelBufferRef pixelBuffer =
+        [_videoOutput copyPixelBufferForItemTime:currentTime itemTimeForDisplay:nil];
+    if (!pixelBuffer) return;
+
+    CVPixelBufferLockBaseAddress (pixelBuffer, kCVPixelBufferLock_ReadOnly);
+
+    const void* baseAddr     = CVPixelBufferGetBaseAddress (pixelBuffer);
+    const uint32_t width     = static_cast<uint32_t> (CVPixelBufferGetWidth (pixelBuffer));
+    const uint32_t height    = static_cast<uint32_t> (CVPixelBufferGetHeight (pixelBuffer));
+    const size_t bytesPerRow = CVPixelBufferGetBytesPerRow (pixelBuffer);
+
+    if (![self ensureTextureWithWidth:width height:height]) {
+        CVPixelBufferUnlockBaseAddress (pixelBuffer, kCVPixelBufferLock_ReadOnly);
+        CVPixelBufferRelease (pixelBuffer);
+        return;
+    }
+
+    MTLRegion region = MTLRegionMake2D (0, 0, width, height);
+    [self.metalTexture replaceRegion:region
+                         mipmapLevel:0
+                           withBytes:baseAddr
+                         bytesPerRow:bytesPerRow];
+
+    CVPixelBufferUnlockBaseAddress (pixelBuffer, kCVPixelBufferLock_ReadOnly);
+    CVPixelBufferRelease (pixelBuffer);
+}
+
+- (id<MTLTexture>)currentMetalTexture {
+    return self.metalTexture;
+}
+
+@end
+
+// ---------------------------------------------------------------------------
+// C++ AVGLPlayer wrapper
+// ---------------------------------------------------------------------------
+
+namespace WallpaperEngine::Render {
+
+AVGLPlayer::AVGLPlayer (const char* videoData, size_t videoSize, uint32_t width, uint32_t height) {
+    WEVideoPlayer* player = [[WEVideoPlayer alloc]
+                             initWithVideoData: videoData
+                                          size: videoSize
+                                         width: width
+                                        height: height];
+    // Retain across the ARC/C++ boundary using __bridge_retained.
+    m_impl = (__bridge_retained void*)player;
+}
+
+AVGLPlayer::~AVGLPlayer () {
+    if (m_impl) {
+        // Transfer ownership back to ARC so it is released.
+        WEVideoPlayer* __unused player = (__bridge_transfer WEVideoPlayer*)m_impl;
+        m_impl = nullptr;
+    }
+}
+
+void AVGLPlayer::setMuted () {
+    ((__bridge WEVideoPlayer*)m_impl).player.muted = YES;
+}
+
+void AVGLPlayer::setVolume (float volume) {
+    ((__bridge WEVideoPlayer*)m_impl).player.volume = volume;
+}
+
+void AVGLPlayer::setUntimed () {
+    // AVFoundation manages its own presentation timing — nothing to do.
+}
+
+void AVGLPlayer::incrementUsageCount () {
+    WEVideoPlayer* p = (__bridge WEVideoPlayer*)m_impl;
+    if (++p.usageCount == 1) [p play];
+}
+
+void AVGLPlayer::decrementUsageCount () {
+    WEVideoPlayer* p = (__bridge WEVideoPlayer*)m_impl;
+    if (--p.usageCount <= 0) {
+        p.usageCount = 0;
+        [p pause];
+    }
+}
+
+void AVGLPlayer::render () {
+    [(__bridge WEVideoPlayer*)m_impl updateTexture];
+}
+
+void* AVGLPlayer::getMetalTexture () const {
+    if (m_impl == nullptr) {
+        return nullptr;
+    }
+
+    return (__bridge void*)[(__bridge WEVideoPlayer*)m_impl currentMetalTexture];
+}
+
+} // namespace WallpaperEngine::Render
+
+#endif // __APPLE__
diff --git a/src/WallpaperEngine/Render/Drivers/CMetalDriver.h b/src/WallpaperEngine/Render/Drivers/CMetalDriver.h
new file mode 100644
index 0000000..9be86f2
--- /dev/null
+++ b/src/WallpaperEngine/Render/Drivers/CMetalDriver.h
@@ -0,0 +1,119 @@
+#pragma once
+#ifdef __APPLE__
+
+#include "VideoDriver.h"
+#include "WallpaperEngine/Application/ApplicationContext.h"
+#include "WallpaperEngine/Application/WallpaperApplication.h"
+#include "WallpaperEngine/Input/Drivers/SimpleMouseInput.h"
+
+namespace WallpaperEngine::Render::Drivers {
+
+using namespace WallpaperEngine::Application;
+
+/**
+ * Metal-based VideoDriver for the embedded macOS host app.
+ *
+ * Replaces GLFWOpenGLDriver on Apple platforms.  Receives an MTLDevice and
+ * MTLCommandQueue from the Swift layer (as void* to keep ObjC out of this
+ * header) and manages the per-frame MTLCommandBuffer lifecycle.
+ *
+ * Frame lifecycle (called by WEBridge):
+ *   1. beginFrame()  – creates the MTLCommandBuffer for this frame
+ *   2. CPass::render() – records Metal work into the command buffer
+ *   3. endFrame()    – commits the command buffer
+ *
+ * dispatchEventQueue() is a no-op: the Swift CVDisplayLink owns the clock.
+ */
+class CMetalDriver final : public VideoDriver {
+public:
+    /**
+     * @param device       id<MTLDevice> as void* (avoids ObjC in this header)
+     * @param commandQueue id<MTLCommandQueue> as void*
+     * @param width        Viewport width in pixels
+     * @param height       Viewport height in pixels
+     * @param context      ApplicationContext (owned by WEContext)
+     * @param app          WallpaperApplication (owned by WEContext)
+     */
+    CMetalDriver (void* device, void* commandQueue,
+                  int width, int height,
+                  ApplicationContext& context, WallpaperApplication& app);
+    ~CMetalDriver () override;
+
+    // ── VideoDriver interface ─────────────────────────────────────────────────
+    [[nodiscard]] Output::Output& getOutput () override;
+    [[nodiscard]] float getRenderTime () const override;
+    bool closeRequested () override;
+    void resizeWindow (glm::ivec2 size) override;
+    void resizeWindow (glm::ivec4 positionAndSize) override;
+    void showWindow () override;
+    void hideWindow () override;
+    [[nodiscard]] glm::ivec2 getFramebufferSize () const override;
+    [[nodiscard]] uint32_t getFrameCounter () const override;
+    [[nodiscard]] void* getProcAddress (const char* name) const override;
+    void dispatchEventQueue () override;
+
+    // ── Metal-specific ────────────────────────────────────────────────────────
+
+    /**
+     * @return id<MTLDevice> as void* (for use by CPass / CFBO)
+     */
+    [[nodiscard]] void* getDevice () const;
+
+    /**
+     * @return id<MTLCommandQueue> as void* (for use by CPass)
+     */
+    [[nodiscard]] void* getCommandQueue () const;
+
+    /**
+     * Begin a frame: creates a new MTLCommandBuffer and stores it.
+     * Must be called before CPass::render() each frame.
+     * @return id<MTLCommandBuffer> as void*
+     */
+    void* beginFrame ();
+
+    /**
+     * Commit the current MTLCommandBuffer and clear it.
+     * Must be called after all CPass::render() calls for the frame.
+     */
+    void endFrame ();
+
+    /**
+     * @return The current frame's id<MTLCommandBuffer> as void*, or nullptr outside a frame.
+     */
+    [[nodiscard]] void* getCurrentCommandBuffer () const;
+
+    /**
+     * Inject a normalised [0,1] mouse position from the Swift host.
+     */
+    void injectMousePosition (double normX, double normY);
+
+    /**
+     * Clear a render-target texture using the current frame command buffer.
+     * No-op when called outside a frame or with a null texture.
+     */
+    void clearTexture (void* texture, float red, float green, float blue, float alpha) const;
+
+    /**
+     * Returns the id<MTLDevice> (as void*) of the active CMetalDriver instance,
+     * or nullptr if no instance exists.  Used by CFBO and CWallpaper to obtain
+     * the device during setup without changing their constructor signatures.
+     */
+    [[nodiscard]] static void* currentDevice ();
+
+private:
+    static CMetalDriver* s_instance;
+    void* m_device;          // id<MTLDevice>
+    void* m_commandQueue;    // id<MTLCommandQueue>
+    void* m_commandBuffer = nullptr; // id<MTLCommandBuffer>, valid only between beginFrame/endFrame
+
+    glm::ivec2 m_viewportSize;
+    uint32_t m_frameCounter = 0;
+    double m_startTime;
+
+    Output::Output* m_output = nullptr;
+    Input::Drivers::SimpleMouseInput m_mouseInput;
+    ApplicationContext& m_context;
+};
+
+} // namespace WallpaperEngine::Render::Drivers
+#endif // __APPLE__
diff --git a/src/WallpaperEngine/Render/Drivers/CMetalDriver.mm b/src/WallpaperEngine/Render/Drivers/CMetalDriver.mm
new file mode 100644
index 0000000..5ff562c
--- /dev/null
+++ b/src/WallpaperEngine/Render/Drivers/CMetalDriver.mm
@@ -0,0 +1,108 @@
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#import <QuartzCore/CABase.h>
+#include "CMetalDriver.h"
+#include "WallpaperEngine/Render/Drivers/Output/MetalOutput.h"
+#include "WallpaperEngine/Logging/Log.h"
+
+using namespace WallpaperEngine::Render::Drivers;
+
+CMetalDriver* CMetalDriver::s_instance = nullptr;
+
+CMetalDriver::CMetalDriver (void* device, void* commandQueue,
+                              int width, int height,
+                              ApplicationContext& context, WallpaperApplication& app) :
+    VideoDriver (app, m_mouseInput),
+    m_device (device),
+    m_commandQueue (commandQueue),
+    m_viewportSize ({ width, height }),
+    m_startTime (CACurrentMediaTime ()),
+    m_context (context) {
+    s_instance = this;
+    m_output = new Output::MetalOutput (context, *this, width, height);
+    sLog.out ("CMetalDriver: initialised (", width, "x", height, ")");
+}
+
+CMetalDriver::~CMetalDriver () {
+    if (s_instance == this) s_instance = nullptr;
+    delete m_output;
+}
+
+Output::Output& CMetalDriver::getOutput () { return *m_output; }
+
+float CMetalDriver::getRenderTime () const {
+    return static_cast<float> (CACurrentMediaTime () - m_startTime);
+}
+
+bool CMetalDriver::closeRequested () { return false; }
+
+void CMetalDriver::resizeWindow (glm::ivec2 size) { m_viewportSize = size; }
+
+void CMetalDriver::resizeWindow (glm::ivec4 positionAndSize) {
+    m_viewportSize = { positionAndSize.z, positionAndSize.w };
+}
+
+void CMetalDriver::showWindow () { }
+void CMetalDriver::hideWindow () { }
+
+glm::ivec2 CMetalDriver::getFramebufferSize () const { return m_viewportSize; }
+
+uint32_t CMetalDriver::getFrameCounter () const { return m_frameCounter; }
+
+void* CMetalDriver::getProcAddress (const char*) const { return nullptr; }
+
+// The Swift CVDisplayLink drives the frame clock; nothing to do here.
+void CMetalDriver::dispatchEventQueue () { }
+
+void* CMetalDriver::getDevice () const { return m_device; }
+
+void* CMetalDriver::getCommandQueue () const { return m_commandQueue; }
+
+void* CMetalDriver::beginFrame () {
+    id<MTLCommandQueue> queue = (__bridge id<MTLCommandQueue>)m_commandQueue;
+    id<MTLCommandBuffer> cmdBuf = [queue commandBuffer];
+    // Retain manually so the void* survives across C++ calls.
+    m_commandBuffer = (__bridge_retained void*)cmdBuf;
+    return m_commandBuffer;
+}
+
+void CMetalDriver::endFrame () {
+    if (!m_commandBuffer) return;
+    id<MTLCommandBuffer> cmdBuf = (__bridge_transfer id<MTLCommandBuffer>)m_commandBuffer;
+    [cmdBuf commit];
+    m_commandBuffer = nullptr;
+    m_frameCounter++;
+}
+
+void* CMetalDriver::getCurrentCommandBuffer () const { return m_commandBuffer; }
+
+void CMetalDriver::injectMousePosition (double normX, double normY) {
+    m_mouseInput.injectPosition (normX, normY);
+}
+
+void CMetalDriver::clearTexture (void* texture, float red, float green, float blue, float alpha) const {
+    if (!m_commandBuffer || !texture) {
+        return;
+    }
+
+    MTLRenderPassDescriptor* rpd = [MTLRenderPassDescriptor renderPassDescriptor];
+    rpd.colorAttachments[0].texture = (__bridge id<MTLTexture>)texture;
+    rpd.colorAttachments[0].loadAction = MTLLoadActionClear;
+    rpd.colorAttachments[0].storeAction = MTLStoreActionStore;
+    rpd.colorAttachments[0].clearColor = MTLClearColorMake (red, green, blue, alpha);
+
+    id<MTLCommandBuffer> cmdBuf = (__bridge id<MTLCommandBuffer>)m_commandBuffer;
+    id<MTLRenderCommandEncoder> enc = [cmdBuf renderCommandEncoderWithDescriptor:rpd];
+    if (enc) {
+        [enc endEncoding];
+    }
+}
+
+void* CMetalDriver::currentDevice () {
+    return s_instance ? s_instance->m_device : nullptr;
+}
+
+extern "C" void* we_current_metal_device () {
+    return CMetalDriver::currentDevice ();
+}
+#endif // __APPLE__
