+        static const std::regex bareKeyPattern (R"(([\{,]\s*)([A-Za-z_][A-Za-z0-9_]*)(\"?)(\s*:))");
+        const auto quotedKeys = std::regex_replace (content, bareKeyPattern, "$1\"$2\"$4");
