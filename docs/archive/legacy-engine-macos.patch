diff --git a/src/WallpaperEngine/Render/Objects/Effects/CPass.mm b/src/WallpaperEngine/Render/Objects/Effects/CPass.mm
new file mode 100644
index 0000000..daa9d5d
--- /dev/null
+++ b/src/WallpaperEngine/Render/Objects/Effects/CPass.mm
@@ -0,0 +1,724 @@
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#include <cstring>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <vector>
+
+#include "CPass.h"
+#include "WallpaperEngine/Render/Objects/CRenderable.h"
+#include "WallpaperEngine/Render/Shaders/GLSLContext.h"
+#include "WallpaperEngine/Render/Drivers/CMetalDriver.h"
+#include "WallpaperEngine/Render/RenderContext.h"
+#include "WallpaperEngine/Render/CFBO.h"
+#include "WallpaperEngine/Logging/Log.h"
+
+#include <glm/gtc/type_ptr.hpp>
+
+using namespace WallpaperEngine::Render::Objects::Effects;
+using namespace WallpaperEngine::Render::Drivers;
+using namespace WallpaperEngine::Render::Shaders;
+using namespace WallpaperEngine::Render::Shaders::Variables;
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Helpers
+// ─────────────────────────────────────────────────────────────────────────────
+
+static std::string sanitizeShaderDumpName (const std::string& input) {
+    std::string out;
+    out.reserve (input.size ());
+
+    for (const char ch : input) {
+        const bool safe
+            = (ch >= 'a' && ch <= 'z')
+              || (ch >= 'A' && ch <= 'Z')
+              || (ch >= '0' && ch <= '9')
+              || ch == '_' || ch == '-' || ch == '.';
+        out.push_back (safe ? ch : '_');
+    }
+
+    return out.empty () ? "unnamed_shader" : out;
+}
+
+static bool metalDebugEnabled () {
+    static const bool enabled = [] {
+        const char* value = std::getenv ("WE_METAL_DEBUG_PASSES");
+        return value != nullptr && value[0] != '\0' && std::strcmp (value, "0") != 0;
+    } ();
+    return enabled;
+}
+
+static bool metalDumpAllShadersEnabled () {
+    static const bool enabled = [] {
+        const char* value = std::getenv ("WE_METAL_DUMP_SHADERS");
+        return value != nullptr && value[0] != '\0' && std::strcmp (value, "0") != 0;
+    } ();
+    return enabled;
+}
+
+static std::string describeSlots (const std::map<std::string, uint32_t>& slots) {
+    if (slots.empty ()) {
+        return "<none>";
+    }
+
+    std::ostringstream out;
+    bool first = true;
+    for (const auto& [name, slot] : slots) {
+        if (!first) {
+            out << ", ";
+        }
+        first = false;
+        out << name << "=" << slot;
+    }
+
+    return out.str ();
+}
+
+static std::string describeMat4 (const glm::mat4& matrix) {
+    std::ostringstream out;
+    out << "[";
+    for (int row = 0; row < 4; ++row) {
+        if (row != 0) {
+            out << " | ";
+        }
+        for (int col = 0; col < 4; ++col) {
+            if (col != 0) {
+                out << ", ";
+            }
+            out << matrix[col][row];
+        }
+    }
+    out << "]";
+    return out.str ();
+}
+
+static glm::mat4 makeMetalClipAdjustMatrix () {
+    glm::mat4 adjust (1.0f);
+    // Wallpaper Engine builds OpenGL-style clip-space matrices where visible Z is [-1, 1].
+    // Metal expects [0, 1], so remap clip-space Z after projection: z' = 0.5 * z + 0.5 * w.
+    adjust[2][2] = 0.5f;
+    adjust[3][2] = 0.5f;
+    return adjust;
+}
+
+static void releaseMetalBuffer (void*& bufferPtr) {
+    if (bufferPtr) {
+        (void)(__bridge_transfer id<MTLBuffer>)bufferPtr;
+        bufferPtr = nullptr;
+    }
+}
+
+static bool updateMetalBuffer (
+    id<MTLDevice> device, void*& bufferPtr, size_t& capacity, const void* data, size_t bytes
+) {
+    if (!device || !data || bytes == 0) {
+        return false;
+    }
+
+    if (!bufferPtr || capacity < bytes) {
+        releaseMetalBuffer (bufferPtr);
+        id<MTLBuffer> newBuffer = [device newBufferWithLength:bytes options:MTLResourceStorageModeShared];
+        if (!newBuffer) {
+            return false;
+        }
+        bufferPtr = (__bridge_retained void*)newBuffer;
+        capacity = bytes;
+    }
+
+    std::memcpy ([(__bridge id<MTLBuffer>)bufferPtr contents], data, bytes);
+    return true;
+}
+
+static std::string describeFloatBuffer (id<MTLBuffer> buffer, size_t count) {
+    if (!buffer || ![buffer contents]) {
+        return "<unavailable>";
+    }
+
+    const auto* values = static_cast<const float*> ([buffer contents]);
+    std::ostringstream out;
+    out << "[";
+    for (size_t index = 0; index < count; ++index) {
+        if (index != 0) {
+            out << ", ";
+        }
+        out << values[index];
+    }
+    out << "]";
+    return out.str ();
+}
+
+static std::string sampleTexturePixel (id<MTLTexture> texture) {
+    if (!texture) {
+        return "<unavailable>";
+    }
+
+    if ((texture.usage & MTLTextureUsageRenderTarget) != 0) {
+        return "<render-target>";
+    }
+
+    const NSUInteger width = texture.width;
+    const NSUInteger height = texture.height;
+    if (width == 0 || height == 0) {
+        return "<empty>";
+    }
+
+    uint8_t rgba[4] = { 0, 0, 0, 0 };
+    const MTLRegion region = MTLRegionMake2D (width / 2, height / 2, 1, 1);
+    [texture getBytes:rgba bytesPerRow:4 fromRegion:region mipmapLevel:0];
+
+    std::ostringstream out;
+    out << "["
+        << static_cast<int> (rgba[0]) << ", "
+        << static_cast<int> (rgba[1]) << ", "
+        << static_cast<int> (rgba[2]) << ", "
+        << static_cast<int> (rgba[3]) << "]";
+    return out.str ();
+}
+
+static void dumpShaderSource (const std::string& shaderName, const std::string& stage, const std::string& source) {
+    try {
+        const std::filesystem::path dumpDir = std::filesystem::temp_directory_path () / "wallpaperengine-shader-dumps";
+        std::filesystem::create_directories (dumpDir);
+
+        const std::filesystem::path dumpPath = dumpDir / (sanitizeShaderDumpName (shaderName) + "." + stage);
+        std::ofstream dump (dumpPath, std::ios::out | std::ios::trunc);
+        dump << source;
+        dump.close ();
+
+        sLog.error ("CPass::setupShadersMetal: dumped ", stage, " shader source for '", shaderName, "' to ",
+                    dumpPath.string ());
+    } catch (const std::exception& ex) {
+        sLog.error ("CPass::setupShadersMetal: failed to dump ", stage, " shader source for '", shaderName,
+                    "': ", ex.what ());
+    }
+}
+
+// Configure MTLRenderPipelineColorAttachmentDescriptor blending from WE's BlendingMode.
+static void configureBlending (MTLRenderPipelineColorAttachmentDescriptor* ca, BlendingMode mode) {
+    switch (mode) {
+        case BlendingMode_Translucent:
+            ca.blendingEnabled                 = YES;
+            ca.sourceRGBBlendFactor            = MTLBlendFactorSourceAlpha;
+            ca.destinationRGBBlendFactor       = MTLBlendFactorOneMinusSourceAlpha;
+            ca.sourceAlphaBlendFactor          = MTLBlendFactorSourceAlpha;
+            ca.destinationAlphaBlendFactor     = MTLBlendFactorOneMinusSourceAlpha;
+            break;
+        case BlendingMode_Additive:
+            ca.blendingEnabled                 = YES;
+            ca.sourceRGBBlendFactor            = MTLBlendFactorSourceAlpha;
+            ca.destinationRGBBlendFactor       = MTLBlendFactorOne;
+            ca.sourceAlphaBlendFactor          = MTLBlendFactorSourceAlpha;
+            ca.destinationAlphaBlendFactor     = MTLBlendFactorOne;
+            break;
+        case BlendingMode_Normal:
+            ca.blendingEnabled                 = YES;
+            ca.sourceRGBBlendFactor            = MTLBlendFactorOne;
+            ca.destinationRGBBlendFactor       = MTLBlendFactorZero;
+            ca.sourceAlphaBlendFactor          = MTLBlendFactorOne;
+            ca.destinationAlphaBlendFactor     = MTLBlendFactorZero;
+            break;
+        default:
+            ca.blendingEnabled = NO;
+            break;
+    }
+}
+
+
+// ─────────────────────────────────────────────────────────────────────────────
+// CPass Metal methods
+// ─────────────────────────────────────────────────────────────────────────────
+
+void CPass::setMetalPositionBuffer (void* buf) { m_metalVertexBuffer = buf; }
+
+void CPass::setMetalTexCoordBuffer (void* buf) { m_metalTexCoordBuffer = buf; }
+
+void CPass::setMetalVertexBinding (const std::string& attributeName, uint32_t offset, uint32_t stride) {
+    const MetalVertexBinding binding { .offset = offset, .stride = stride };
+    const auto previous = m_metalVertexBindings.find (attributeName);
+    const bool changed = previous == m_metalVertexBindings.end ()
+                         || previous->second.offset != offset
+                         || previous->second.stride != stride;
+    m_metalVertexBindings[attributeName] = binding;
+    if (changed) {
+        m_metalVertexDescriptorDirty = true;
+    }
+}
+
+void CPass::uploadMetalVertexData (const void* data, size_t bytes) {
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) {
+        return;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+    if (!updateMetalBuffer (device, m_metalCustomVertexBuffer, m_metalCustomVertexBufferBytes, data, bytes)) {
+        sLog.error ("CPass::uploadMetalVertexData: failed to allocate Metal vertex buffer for '", m_pass.shader, "'");
+    }
+}
+
+void CPass::uploadMetalIndexData (const uint32_t* data, uint32_t indexCount) {
+    m_metalIndexCount = indexCount;
+    if (indexCount == 0) {
+        return;
+    }
+
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) {
+        return;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+    const size_t bytes = static_cast<size_t> (indexCount) * sizeof (uint32_t);
+    if (!updateMetalBuffer (device, m_metalIndexBuffer, m_metalIndexBufferBytes, data, bytes)) {
+        sLog.error ("CPass::uploadMetalIndexData: failed to allocate Metal index buffer for '", m_pass.shader, "'");
+        m_metalIndexCount = 0;
+    }
+}
+
+void CPass::setupShadersMetal () {
+    const std::string& vertexSource = m_shader->vertex ();
+    const std::string& fragmentSource = m_shader->fragment ();
+    auto msl = GLSLContext::get ().toMsl (vertexSource, fragmentSource);
+
+    if (metalDumpAllShadersEnabled ()) {
+        dumpShaderSource (m_pass.shader, "vertex.msl", msl.vertexMSL);
+        dumpShaderSource (m_pass.shader, "fragment.msl", msl.fragmentMSL);
+    }
+
+    if (msl.vertexMSL.empty () || msl.fragmentMSL.empty ()) {
+        sLog.error ("CPass::setupShadersMetal: toMsl() returned empty source for '", m_pass.shader, "'");
+        dumpShaderSource (m_pass.shader, "vertex.glsl", vertexSource);
+        dumpShaderSource (m_pass.shader, "fragment.glsl", fragmentSource);
+        return;
+    }
+
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) {
+        sLog.error ("CPass::setupShadersMetal: no MTLDevice available");
+        return;
+    }
+
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+    NSError* err = nil;
+
+    // ── Compile vertex MSL ────────────────────────────────────────────────────
+    id<MTLLibrary> vertLib = [device newLibraryWithSource:@(msl.vertexMSL.c_str ())
+                                                  options:nil
+                                                    error:&err];
+    if (!vertLib) {
+        sLog.error ("CPass::setupShadersMetal: vertex MSL compile failed for '", m_pass.shader,
+                    "': ", err.localizedDescription.UTF8String);
+        dumpShaderSource (m_pass.shader, "vertex.msl", msl.vertexMSL);
+        sLog.error ("Vertex MSL:\n", msl.vertexMSL);
+        return;
+    }
+
+    // ── Compile fragment MSL ──────────────────────────────────────────────────
+    err = nil;
+    id<MTLLibrary> fragLib = [device newLibraryWithSource:@(msl.fragmentMSL.c_str ())
+                                                  options:nil
+                                                    error:&err];
+    if (!fragLib) {
+        sLog.error ("CPass::setupShadersMetal: fragment MSL compile failed for '", m_pass.shader,
+                    "': ", err.localizedDescription.UTF8String);
+        dumpShaderSource (m_pass.shader, "fragment.msl", msl.fragmentMSL);
+        sLog.error ("Fragment MSL:\n", msl.fragmentMSL);
+        return;
+    }
+
+    id<MTLFunction> vertFn = [vertLib newFunctionWithName:@"main0"];
+    id<MTLFunction> fragFn = [fragLib newFunctionWithName:@"main0"];
+
+    if (!vertFn || !fragFn) {
+        sLog.error ("CPass::setupShadersMetal: 'main0' entry point not found in MSL for '", m_pass.shader, "'");
+        return;
+    }
+
+    // ── Vertex descriptor ─────────────────────────────────────────────────────
+    // SPIRV-Cross auto-assigns uniform buffer slots starting from 0.
+    // Vertex attribute data uses slots kVertexDataBaseSlot + location (e.g. 28, 29)
+    // so it never collides with the auto-assigned uniform slots.
+    MTLVertexDescriptor* vdesc = [MTLVertexDescriptor new];
+    for (const auto& attr : msl.vertexAttributes) {
+        // Map float vecsize to MTLVertexFormat.
+        MTLVertexFormat fmt;
+        uint32_t stride;
+        switch (attr.vecsize) {
+            case 1:  fmt = MTLVertexFormatFloat;  stride =  4; break;
+            case 2:  fmt = MTLVertexFormatFloat2; stride =  8; break;
+            case 3:  fmt = MTLVertexFormatFloat3; stride = 12; break;
+            case 4:  fmt = MTLVertexFormatFloat4; stride = 16; break;
+            default: fmt = MTLVertexFormatFloat4; stride = 16; break;
+        }
+        NSUInteger attrIdx = static_cast<NSUInteger> (attr.location);
+        NSUInteger bufIdx  = static_cast<NSUInteger> (attr.bufferIndex);
+        NSUInteger offset  = 0;
+
+        if (const auto bindingIt = m_metalVertexBindings.find (attr.name); bindingIt != m_metalVertexBindings.end ()) {
+            offset = bindingIt->second.offset;
+            if (bindingIt->second.stride != 0) {
+                stride = bindingIt->second.stride;
+            }
+        }
+
+        vdesc.attributes[attrIdx].format      = fmt;
+        vdesc.attributes[attrIdx].bufferIndex = bufIdx;
+        vdesc.attributes[attrIdx].offset      = offset;
+        vdesc.layouts[bufIdx].stride           = stride;
+        vdesc.layouts[bufIdx].stepFunction     = MTLVertexStepFunctionPerVertex;
+    }
+
+    // ── Pipeline state ────────────────────────────────────────────────────────
+    MTLRenderPipelineDescriptor* psoDesc = [MTLRenderPipelineDescriptor new];
+    psoDesc.vertexFunction               = vertFn;
+    psoDesc.fragmentFunction             = fragFn;
+    psoDesc.vertexDescriptor             = vdesc;
+    psoDesc.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    configureBlending (psoDesc.colorAttachments[0], m_blendingmode);
+
+#if !NDEBUG
+    psoDesc.label = [NSString stringWithUTF8String:m_pass.shader.c_str ()];
+#endif
+
+    err = nil;
+    id<MTLRenderPipelineState> pso = [device newRenderPipelineStateWithDescriptor:psoDesc error:&err];
+    if (!pso) {
+        sLog.error ("CPass::setupShadersMetal: PSO creation failed for '", m_pass.shader,
+                    "': ", err.localizedDescription.UTF8String);
+        return;
+    }
+
+    // ── Default sampler state ─────────────────────────────────────────────────
+    // Used for all fragment textures. Linear filter + repeat addressing covers
+    // the vast majority of WE scene wallpapers.
+    MTLSamplerDescriptor* sd = [MTLSamplerDescriptor new];
+    sd.minFilter     = MTLSamplerMinMagFilterLinear;
+    sd.magFilter     = MTLSamplerMinMagFilterLinear;
+    sd.mipFilter     = MTLSamplerMipFilterLinear;
+    sd.sAddressMode  = MTLSamplerAddressModeRepeat;
+    sd.tAddressMode  = MTLSamplerAddressModeRepeat;
+    id<MTLSamplerState> sampler = [device newSamplerStateWithDescriptor:sd];
+    if (m_defaultSamplerState)
+        (void)(__bridge_transfer id<MTLSamplerState>)m_defaultSamplerState;
+    m_defaultSamplerState = (__bridge_retained void*)sampler;
+
+    m_pipelineState         = (__bridge_retained void*)pso;
+    m_vertexAttributes      = msl.vertexAttributes;
+    m_vertexUniformSlots    = std::move (msl.vertexUniformSlots);
+    m_fragmentUniformSlots  = std::move (msl.fragmentUniformSlots);
+    m_fragmentTextureSlots  = std::move (msl.fragmentTextureSlots);
+    m_fragmentSamplerSlots  = std::move (msl.fragmentSamplerSlots);
+    m_metalVertexDescriptorDirty = false;
+
+    if (metalDebugEnabled ()) {
+        sLog.out (
+            "CPass::setupShadersMetal: shader=", m_pass.shader,
+            " vertexUniformSlots=[", describeSlots (m_vertexUniformSlots), "]",
+            " fragmentUniformSlots=[", describeSlots (m_fragmentUniformSlots), "]",
+            " fragmentTextureSlots=[", describeSlots (m_fragmentTextureSlots), "]",
+            " fragmentSamplerSlots=[", describeSlots (m_fragmentSamplerSlots), "]"
+        );
+    }
+}
+
+void CPass::destroyMetal () {
+    if (m_pipelineState) {
+        (void)(__bridge_transfer id<MTLRenderPipelineState>)m_pipelineState;
+        m_pipelineState = nullptr;
+    }
+    if (m_defaultSamplerState) {
+        (void)(__bridge_transfer id<MTLSamplerState>)m_defaultSamplerState;
+        m_defaultSamplerState = nullptr;
+    }
+    m_vertexAttributes.clear ();
+    // m_metalVertexBuffer and m_metalTexCoordBuffer are borrowed; not released here.
+}
+
+void CPass::destroyMetalBuffers () {
+    releaseMetalBuffer (m_metalCustomVertexBuffer);
+    releaseMetalBuffer (m_metalIndexBuffer);
+    m_metalCustomVertexBufferBytes = 0;
+    m_metalIndexBufferBytes = 0;
+    m_metalIndexCount = 0;
+}
+
+void CPass::renderMetal () {
+    if (m_metalVertexDescriptorDirty) {
+        this->destroyMetal ();
+        this->setupShadersMetal ();
+    }
+
+    if (!m_pipelineState || !m_drawTo) return;
+
+    const auto& driver = static_cast<const CMetalDriver&> (this->getContext ().getDriver ());
+    void* cmdBufPtr = driver.getCurrentCommandBuffer ();
+    if (!cmdBufPtr) {
+        sLog.error ("CPass::renderMetal: no active command buffer for '", m_pass.shader, "'");
+        return;
+    }
+
+    id<MTLCommandBuffer> cmdBuf = (__bridge id<MTLCommandBuffer>)cmdBufPtr;
+    void* colorTexPtr = m_drawTo->getMetalTexture ();
+    if (!colorTexPtr) {
+        sLog.error ("CPass::renderMetal: destination FBO has no Metal texture");
+        return;
+    }
+
+    // ── Render pass descriptor ────────────────────────────────────────────────
+    MTLRenderPassDescriptor* rpd = [MTLRenderPassDescriptor renderPassDescriptor];
+    rpd.colorAttachments[0].texture     = (__bridge id<MTLTexture>)colorTexPtr;
+    rpd.colorAttachments[0].loadAction  = MTLLoadActionLoad;   // preserve existing content
+    rpd.colorAttachments[0].storeAction = MTLStoreActionStore;
+
+    id<MTLRenderCommandEncoder> enc = [cmdBuf renderCommandEncoderWithDescriptor:rpd];
+    if (!enc) {
+        sLog.error ("CPass::renderMetal: failed to create render command encoder");
+        return;
+    }
+
+    [enc setRenderPipelineState:(__bridge id<MTLRenderPipelineState>)m_pipelineState];
+
+    // Set viewport to destination dimensions
+    MTLViewport vp;
+    vp.originX = 0; vp.originY = 0;
+    vp.width   = static_cast<double> (m_drawTo->getRealWidth ());
+    vp.height  = static_cast<double> (m_drawTo->getRealHeight ());
+    vp.znear   = 0.0; vp.zfar = 1.0;
+    [enc setViewport:vp];
+
+    // ── Vertex attribute data ─────────────────────────────────────────────────
+    // Bound at kVertexDataBaseSlot + location (28, 29, …); matches the vertex descriptor.
+    bool usedCustomBindings = false;
+    if (m_metalCustomVertexBuffer && !m_metalVertexBindings.empty ()) {
+        id<MTLBuffer> customBuffer = (__bridge id<MTLBuffer>)m_metalCustomVertexBuffer;
+        for (const auto& attr : m_vertexAttributes) {
+            if (m_metalVertexBindings.find (attr.name) != m_metalVertexBindings.end ()) {
+                [enc setVertexBuffer:customBuffer offset:0 atIndex:attr.bufferIndex];
+                usedCustomBindings = true;
+            }
+        }
+    }
+
+    if (!usedCustomBindings) {
+        if (m_metalVertexBuffer)
+            [enc setVertexBuffer:(__bridge id<MTLBuffer>)m_metalVertexBuffer
+                         offset:0
+                        atIndex:GLSLContext::kVertexDataBaseSlot + 0]; // a_Position (location 0)
+        if (m_metalTexCoordBuffer)
+            [enc setVertexBuffer:(__bridge id<MTLBuffer>)m_metalTexCoordBuffer
+                         offset:0
+                        atIndex:GLSLContext::kVertexDataBaseSlot + 1]; // a_TexCoord (location 1)
+    }
+
+    // ── Resolve primary texture animation state ───────────────────────────────
+    auto primaryTexture = this->resolveTexture (m_input, 0, m_input);
+
+    if (metalDebugEnabled ()) {
+        sLog.out (
+            "CPass::renderMetal: shader=", m_pass.shader,
+            " dst=", m_drawTo->getName (),
+            " size=", m_drawTo->getRealWidth (), "x", m_drawTo->getRealHeight (),
+            " input=", (primaryTexture ? primaryTexture->getRealWidth () : 0), "x",
+            (primaryTexture ? primaryTexture->getRealHeight () : 0)
+        );
+
+        if (auto it = m_referenceUniforms.find ("g_ModelViewProjectionMatrix"); it != m_referenceUniforms.end ()
+            && *it->second->value) {
+            const auto* matrix = reinterpret_cast<const glm::mat4*> (*it->second->value);
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " mvp=", describeMat4 (*matrix));
+        }
+        if (m_metalVertexBuffer) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " positions=",
+                      describeFloatBuffer ((__bridge id<MTLBuffer>)m_metalVertexBuffer, 18));
+        }
+        if (m_metalTexCoordBuffer) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " texcoords=",
+                      describeFloatBuffer ((__bridge id<MTLBuffer>)m_metalTexCoordBuffer, 12));
+        }
+        if (primaryTexture) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " sampledInput=",
+                      sampleTexturePixel ((__bridge id<MTLTexture>)primaryTexture->getMetalTexture ()));
+        }
+        if (auto it = m_uniforms.find ("g_Brightness"); it != m_uniforms.end ()) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " g_Brightness=",
+                      *reinterpret_cast<const float*> (it->second->value));
+        }
+        if (auto it = m_uniforms.find ("g_UserAlpha"); it != m_uniforms.end ()) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " g_UserAlpha=",
+                      *reinterpret_cast<const float*> (it->second->value));
+        }
+        if (auto it = m_uniforms.find ("g_Power"); it != m_uniforms.end ()) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " g_Power=",
+                      *reinterpret_cast<const float*> (it->second->value));
+        }
+        if (auto it = m_uniforms.find ("g_Color1"); it != m_uniforms.end ()) {
+            const auto* color = reinterpret_cast<const glm::vec3*> (it->second->value);
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " g_Color1=[",
+                      color->r, ", ", color->g, ", ", color->b, "]");
+        }
+        if (auto it = m_uniforms.find ("g_Color2"); it != m_uniforms.end ()) {
+            const auto* color = reinterpret_cast<const glm::vec3*> (it->second->value);
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " g_Color2=[",
+                      color->r, ", ", color->g, ", ", color->b, "]");
+        }
+        if (m_metalCustomVertexBuffer && m_metalIndexCount > 0) {
+            sLog.out ("CPass::renderMetal: shader=", m_pass.shader, " customVertexHead=",
+                      describeFloatBuffer ((__bridge id<MTLBuffer>)m_metalCustomVertexBuffer, 17));
+        }
+    }
+
+    uint32_t currentTextureFrame = 0;
+    glm::vec4 g_Texture0Rotation_val    = { 1.0f, 0.0f, 0.0f, 1.0f }; // identity
+    glm::vec2 g_Texture0Translation_val = { 0.0f, 0.0f };
+
+    if (primaryTexture && primaryTexture->isAnimated ()) {
+        double currentRenderTime = fmod (
+            static_cast<double> (this->getContext ().getDriver ().getRenderTime ()),
+            this->m_renderable.getAnimationTime ()
+        );
+        for (const auto& frameCur : primaryTexture->getFrames ()) {
+            currentRenderTime -= frameCur->frametime;
+            if (currentRenderTime <= 0.0) {
+                currentTextureFrame = frameCur->frameNumber;
+                float tw = static_cast<float> (primaryTexture->getTextureWidth (currentTextureFrame));
+                float th = static_cast<float> (primaryTexture->getTextureHeight (currentTextureFrame));
+                g_Texture0Translation_val = { frameCur->x / tw, frameCur->y / th };
+                g_Texture0Rotation_val    = {
+                    frameCur->width1  / tw,
+                    frameCur->width2  / tw,
+                    frameCur->height2 / th,
+                    frameCur->height1 / th
+                };
+                break;
+            }
+        }
+    }
+
+    // Helper: byte size for a uniform value given its type and element count.
+    // Defined as a lambda inside the class method so it can access the private
+    // UniformType enum values via class scope.
+    auto uniBytes = [&] (UniformType type, int count) -> size_t {
+        switch (type) {
+            case Float:   return sizeof (float) * static_cast<size_t> (count);
+            case Integer: return sizeof (int)   * static_cast<size_t> (count);
+            case Vector2: return sizeof (glm::vec2) * static_cast<size_t> (count);
+            case Vector3: return sizeof (glm::vec3) * static_cast<size_t> (count);
+            case Vector4: return sizeof (glm::vec4) * static_cast<size_t> (count);
+            case Matrix3: return sizeof (glm::mat3) * static_cast<size_t> (count);
+            case Matrix4: return sizeof (glm::mat4) * static_cast<size_t> (count);
+            default:      return 0;
+        }
+    };
+
+    // ── Vertex stage uniforms ─────────────────────────────────────────────────
+    // Each uniform is a separate 'constant T&' parameter in the generated MSL;
+    // bind them individually at the slot reflected from the MSL signature.
+    const glm::mat4 metalClipAdjust = makeMetalClipAdjustMatrix ();
+
+    auto bindVertexUniform = [&] (const std::string& name, const void* value, size_t bytes) {
+        if (!value || bytes == 0) return;
+        if (auto it = m_vertexUniformSlots.find (name); it != m_vertexUniformSlots.end ()) {
+            if (name == "g_ModelViewProjectionMatrix" && bytes == sizeof (glm::mat4)) {
+                const auto adjusted = metalClipAdjust * (*reinterpret_cast<const glm::mat4*> (value));
+                [enc setVertexBytes:&adjusted length:sizeof (adjusted) atIndex:it->second];
+                return;
+            }
+            [enc setVertexBytes:value length:bytes atIndex:it->second];
+        }
+    };
+
+    bindVertexUniform ("g_Texture0Rotation",    glm::value_ptr (g_Texture0Rotation_val),
+                       sizeof (glm::vec4));
+    bindVertexUniform ("g_Texture0Translation", glm::value_ptr (g_Texture0Translation_val),
+                       sizeof (glm::vec2));
+
+    for (const auto& [name, entry] : m_uniforms) {
+        const size_t bytes = uniBytes (entry->type, entry->count);
+        if (bytes > 0) bindVertexUniform (name, entry->value, bytes);
+    }
+    for (const auto& [name, entry] : m_referenceUniforms) {
+        if (!*entry->value) continue;
+        const size_t bytes = uniBytes (entry->type, 1);
+        if (bytes > 0) bindVertexUniform (name, *entry->value, bytes);
+    }
+
+    // ── Fragment stage uniforms ───────────────────────────────────────────────
+    auto bindFragmentUniform = [&] (const std::string& name, const void* value, size_t bytes) {
+        if (!value || bytes == 0) return;
+        if (auto it = m_fragmentUniformSlots.find (name); it != m_fragmentUniformSlots.end ())
+            [enc setFragmentBytes:value length:bytes atIndex:it->second];
+    };
+
+    bindFragmentUniform ("g_Texture0Rotation",    glm::value_ptr (g_Texture0Rotation_val),
+                         sizeof (glm::vec4));
+    bindFragmentUniform ("g_Texture0Translation", glm::value_ptr (g_Texture0Translation_val),
+                         sizeof (glm::vec2));
+
+    for (const auto& [name, entry] : m_uniforms) {
+        const size_t bytes = uniBytes (entry->type, entry->count);
+        if (bytes > 0) bindFragmentUniform (name, entry->value, bytes);
+    }
+    for (const auto& [name, entry] : m_referenceUniforms) {
+        if (!*entry->value) continue;
+        const size_t bytes = uniBytes (entry->type, 1);
+        if (bytes > 0) bindFragmentUniform (name, *entry->value, bytes);
+    }
+
+    // ── Fragment textures ─────────────────────────────────────────────────────
+    // WE texture semantic slot N corresponds to GLSL name "g_TextureN".
+    // SPIRV-Cross auto-assigns texture slots sequentially in SPIR-V declaration order,
+    // which for WE shaders matches the semantic slot order (0, 1, 2, …).
+    // We use the parsed fragmentTextureSlots to bind at the correct Metal slot.
+
+    auto bindTexture = [&] (const std::string& glslName, const TextureProvider* provider) {
+        if (!provider) return;
+        void* t = provider->getMetalTexture ();
+        if (!t) return;
+
+        auto texIt  = m_fragmentTextureSlots.find (glslName);
+        auto smpIt  = m_fragmentSamplerSlots.find (glslName + "Smplr");
+        if (texIt != m_fragmentTextureSlots.end ())
+            [enc setFragmentTexture:(__bridge id<MTLTexture>)t atIndex:texIt->second];
+        if (smpIt != m_fragmentSamplerSlots.end () && m_defaultSamplerState)
+            [enc setFragmentSamplerState:(__bridge id<MTLSamplerState>)m_defaultSamplerState
+                                 atIndex:smpIt->second];
+    };
+
+    // Primary texture (slot 0 → g_Texture0)
+    if (primaryTexture) bindTexture ("g_Texture0", primaryTexture.get ());
+
+    // Additional textures (WE slot N → g_TextureN)
+    for (const auto& [weSlot, texProvider] : m_textures) {
+        const std::string name = "g_Texture" + std::to_string (weSlot);
+        auto resolved = texProvider ? texProvider.get () : (primaryTexture ? primaryTexture.get () : nullptr);
+        if (resolved) bindTexture (name, resolved);
+    }
+
+    // ── Draw ──────────────────────────────────────────────────────────────────
+    if (m_metalIndexBuffer && m_metalIndexCount > 0) {
+        if (metalDebugEnabled ()) {
+            sLog.out (
+                "CPass::renderMetal: shader=", m_pass.shader,
+                " indexedDraw=", m_metalIndexCount,
+                " customVertexBufferBytes=", m_metalCustomVertexBufferBytes
+            );
+        }
+        [enc drawIndexedPrimitives:MTLPrimitiveTypeTriangle
+                        indexCount:m_metalIndexCount
+                         indexType:MTLIndexTypeUInt32
+                       indexBuffer:(__bridge id<MTLBuffer>)m_metalIndexBuffer
+                 indexBufferOffset:0];
+    } else if (m_drawGeometryCallback) {
+        // Particles and other custom-geometry callers provide their own draw logic.
+        // On Metal this callback must encode Metal draw calls; not yet supported here.
+        sLog.error ("CPass::renderMetal: custom geometry callback not yet supported on Metal");
+    } else {
+        [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:6];
+    }
+
+    [enc endEncoding];
+}
