+#include <sstream>
+#include <vector>
+
 using namespace WallpaperEngine::Data::Parsers;
 using namespace WallpaperEngine::Data::Builders;
 
+namespace {
+bool isNumericToken (const std::string& token) {
+    if (token.empty ()) {
+        return false;
+    }
+
+    char* end = nullptr;
+    std::strtod (token.c_str (), &end);
+    return end != token.c_str () && *end == '\0';
+}
+
+bool parseNumericVector (const std::string& input, DynamicValue& value) {
+    std::istringstream stream (input);
+    std::vector<std::string> tokens;
+    std::string token;
+
+    while (stream >> token) {
+        tokens.push_back (token);
+    }
+
+    if (tokens.size () < 2 || tokens.size () > 4) {
+        return false;
+    }
+
+    if (std::any_of (tokens.begin (), tokens.end (), [] (const auto& cur) { return isNumericToken (cur) == false; })) {
+        return false;
+    }
+
+    if (tokens.size () == 2) {
+        value.update (VectorBuilder::parse<glm::vec2> (input));
+    } else if (tokens.size () == 3) {
+        value.update (VectorBuilder::parse<glm::vec3> (input));
+    } else {
+        value.update (VectorBuilder::parse<glm::vec4> (input));
+    }
+
+    return true;
+}
