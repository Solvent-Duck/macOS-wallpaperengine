index 0000000..73b1dd0
--- /dev/null
+++ b/src/WallpaperEngine/Render/CTexture.mm
@@ -0,0 +1,292 @@
+#ifdef __APPLE__
+#import <Metal/Metal.h>
+#include <array>
+#include <cstring>
+#include <filesystem>
+#include "CTexture.h"
+#include "WallpaperEngine/Render/Drivers/CMetalDriver.h"
+#include "WallpaperEngine/Logging/Log.h"
+
+// stb_image implementation is provided by CTexture.cpp; just include the declarations here.
+#include <stb_image.h>
+
+using namespace WallpaperEngine::Render;
+using namespace WallpaperEngine::Render::Drivers;
+using namespace WallpaperEngine::Data::Assets;
+
+static MTLPixelFormat metalPixelFormat (TextureFormat fmt) {
+    switch (fmt) {
+        case TextureFormat_ARGB8888: return MTLPixelFormatRGBA8Unorm;
+        case TextureFormat_R8:       return MTLPixelFormatR8Unorm;
+        case TextureFormat_RG88:     return MTLPixelFormatRG8Unorm;
+        case TextureFormat_DXT1:     return MTLPixelFormatBC1_RGBA;
+        case TextureFormat_DXT3:     return MTLPixelFormatBC2_RGBA;
+        case TextureFormat_DXT5:     return MTLPixelFormatBC3_RGBA;
+        default:                     return MTLPixelFormatInvalid;
+    }
+}
+
+// Bytes-per-block for BCn formats (each block covers a 4x4 texel region).
+static uint32_t bcBlockBytes (MTLPixelFormat fmt) {
+    switch (fmt) {
+        case MTLPixelFormatBC1_RGBA: return 8;
+        case MTLPixelFormatBC2_RGBA: return 16;
+        case MTLPixelFormatBC3_RGBA: return 16;
+        default:                     return 0;
+    }
+}
+
+bool CTexture::initMetalTextureFromSidecar () {
+    if (m_sourceName.empty () || m_assetLocator == nullptr) {
+        return false;
+    }
+
+    const bool isNonPowerOfTwo
+        = this->m_header->width != this->m_header->textureWidth
+          || this->m_header->height != this->m_header->textureHeight;
+    const bool isCompressed
+        = this->m_header->format == TextureFormat_DXT1
+          || this->m_header->format == TextureFormat_DXT3
+          || this->m_header->format == TextureFormat_DXT5;
+    if (!isCompressed || !isNonPowerOfTwo) {
+        return false;
+    }
+
+    static constexpr std::array<const char*, 5> extensions = { ".png", ".tga", ".jpg", ".jpeg", ".webp" };
+    std::filesystem::path sidecarPath;
+    for (const char* ext : extensions) {
+        try {
+            sidecarPath = m_assetLocator->physicalPath (std::filesystem::path ("materials") / (m_sourceName + ext));
+            if (!sidecarPath.empty ()) {
+                break;
+            }
+        } catch (...) {
+        }
+    }
+
+    if (sidecarPath.empty ()) {
+        return false;
+    }
+
+    int decodeWidth = 0;
+    int decodeHeight = 0;
+    int channels = 0;
+    stbi_uc* decoded = stbi_load (sidecarPath.string ().c_str (), &decodeWidth, &decodeHeight, &channels, 4);
+    if (decoded == nullptr) {
+        sLog.error ("CTexture::initMetalTextureFromSidecar: failed to decode ", sidecarPath.string (),
+                    ": ", stbi_failure_reason ());
+        return false;
+    }
+
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) {
+        stbi_image_free (decoded);
+        return false;
+    }
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+
+    const NSUInteger paddedWidth = this->m_header->textureWidth;
+    const NSUInteger paddedHeight = this->m_header->textureHeight;
+    MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                    width:paddedWidth
+                                                                                   height:paddedHeight
+                                                                                mipmapped:NO];
+    desc.usage = MTLTextureUsageShaderRead;
+    desc.storageMode = MTLStorageModeShared;
+
+    id<MTLTexture> tex = [device newTextureWithDescriptor:desc];
+    if (!tex) {
+        stbi_image_free (decoded);
+        return false;
+    }
+
+    std::vector<uint8_t> padded (paddedWidth * paddedHeight * 4, 0);
+    for (int row = 0; row < decodeHeight; ++row) {
+        std::memcpy (
+            padded.data () + static_cast<size_t> (row) * paddedWidth * 4,
+            decoded + static_cast<size_t> (row) * decodeWidth * 4,
+            static_cast<size_t> (decodeWidth) * 4
+        );
+    }
+
+    MTLRegion region = MTLRegionMake2D (0, 0, paddedWidth, paddedHeight);
+    [tex replaceRegion:region
+          mipmapLevel:0
+            withBytes:padded.data ()
+          bytesPerRow:paddedWidth * 4];
+
+    stbi_image_free (decoded);
+    this->m_metalTexture = (__bridge_retained void*)tex;
+    sLog.out ("CTexture::initMetalTextureFromSidecar: loaded ", m_sourceName, " from ", sidecarPath.string (),
+              " into padded Metal texture ", paddedWidth, "x", paddedHeight);
+    return true;
+}
+
+void CTexture::initMetalTexture () {
+    void* devicePtr = CMetalDriver::currentDevice ();
+    if (!devicePtr) {
+        sLog.error ("CTexture::initMetalTexture: no Metal device available");
+        return;
+    }
+    id<MTLDevice> device = (__bridge id<MTLDevice>)devicePtr;
+
+    if (this->initMetalTextureFromSidecar ()) {
+        return;
+    }
+
+    // We only upload the first image (index 0) to Metal for now.
+    // Animated GIFs use spritesheet data which is baked into a single texture.
+    auto imgIt = this->m_header->images.find (0);
+    if (imgIt == this->m_header->images.end () || imgIt->second.empty ()) {
+        sLog.error ("CTexture::initMetalTexture: no image data found");
+        return;
+    }
+
+    const auto& mipmaps = imgIt->second;
+    const auto& firstMip = mipmaps.front ();
+
+    int uploadWidth  = firstMip->width;
+    int uploadHeight = firstMip->height;
+    MTLPixelFormat pixelFmt = MTLPixelFormatInvalid;
+
+    // --- stbi-decoded images (freeImageFormat != FIF_UNKNOWN) ---------------
+    // These are stored as JPEG/PNG inside the TEXB container; stbi decodes them
+    // to raw RGBA8 on the fly.
+    if (this->m_header->freeImageFormat != FIF_UNKNOWN) {
+        int fileChannels = 0;
+        stbi_uc* decoded = stbi_load_from_memory (
+            reinterpret_cast<unsigned char*> (firstMip->uncompressedData.get ()),
+            firstMip->uncompressedSize,
+            &uploadWidth, &uploadHeight, &fileChannels, 4
+        );
+        if (decoded == nullptr) {
+            sLog.error ("CTexture::initMetalTexture: stbi decode failed: ", stbi_failure_reason ());
+            return;
+        }
+
+        MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                        width:uploadWidth
+                                                                                       height:uploadHeight
+                                                                                    mipmapped:NO];
+        desc.usage        = MTLTextureUsageShaderRead;
+        desc.storageMode  = MTLStorageModeShared; // CPU-writable; fine for static textures
+
+        id<MTLTexture> tex = [device newTextureWithDescriptor:desc];
+        if (!tex) {
+            sLog.error ("CTexture::initMetalTexture: MTLTexture allocation failed");
+            stbi_image_free (decoded);
+            return;
+        }
+
+        MTLRegion region = MTLRegionMake2D (0, 0, uploadWidth, uploadHeight);
+        [tex replaceRegion:region
+              mipmapLevel:0
+                withBytes:decoded
+              bytesPerRow:static_cast<NSUInteger> (uploadWidth) * 4];
+
+        stbi_image_free (decoded);
+        this->m_metalTexture = (__bridge_retained void*)tex;
+        return;
+    }
+
+    // --- Raw / BCn textures -------------------------------------------------
+    pixelFmt = metalPixelFormat (this->m_header->format);
+    if (pixelFmt == MTLPixelFormatInvalid) {
+        sLog.error ("CTexture::initMetalTexture: unsupported texture format ", this->m_header->format);
+        return;
+    }
+
+    const uint32_t mipCount = static_cast<uint32_t> (mipmaps.size ());
+    MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:pixelFmt
+                                                                                    width:uploadWidth
+                                                                                   height:uploadHeight
+                                                                                mipmapped:(mipCount > 1)];
+    desc.mipmapLevelCount = mipCount;
+    desc.usage            = MTLTextureUsageShaderRead;
+    desc.storageMode      = MTLStorageModeShared;
+
+    id<MTLTexture> tex = [device newTextureWithDescriptor:desc];
+    if (!tex) {
+        sLog.error ("CTexture::initMetalTexture: MTLTexture allocation failed");
+        return;
+    }
+
+    const uint32_t blockBytes = bcBlockBytes (pixelFmt);
+    const bool isCompressed   = (blockBytes > 0);
+
+    for (uint32_t level = 0; level < mipCount; ++level) {
+        const auto& mip   = mipmaps[level];
+        int mipW          = mip->width;
+        int mipH          = mip->height;
+        const void* bytes = mip->uncompressedData.get ();
+
+        if (isCompressed) {
+            // Compressed block formats: bytesPerRow is in blocks, not pixels.
+            const uint32_t blocksWide   = static_cast<uint32_t> (std::max (1, (mipW + 3) / 4));
+            const uint32_t blocksHigh   = static_cast<uint32_t> (std::max (1, (mipH + 3) / 4));
+            const NSUInteger bytesPerRow = blocksWide * blockBytes;
+            const NSUInteger bytesPerImg = bytesPerRow * blocksHigh;
+
+            MTLRegion region = MTLRegionMake2D (0, 0, mipW, mipH);
+            [tex replaceRegion:region
+                  mipmapLevel:level
+                        slice:0
+                    withBytes:bytes
+                  bytesPerRow:bytesPerRow
+                bytesPerImage:bytesPerImg];
+        } else {
+            // Uncompressed path: detect if data looks smaller than expected and
+            // fall back to stbi (mirrors the GL path's size-mismatch fallback).
+            const int bpp = (this->m_header->format == TextureFormat_R8)  ? 1
+                          : (this->m_header->format == TextureFormat_RG88) ? 2 : 4;
+            const uint32_t expectedBytes = static_cast<uint32_t> (mipW) * static_cast<uint32_t> (mipH) * bpp;
+
+            if (static_cast<uint32_t> (mip->uncompressedSize) < expectedBytes) {
+                int fileChannels = 0, decW = 0, decH = 0;
+                stbi_uc* decoded = stbi_load_from_memory (
+                    reinterpret_cast<unsigned char*> (mip->uncompressedData.get ()),
+                    mip->uncompressedSize, &decW, &decH, &fileChannels, 4
+                );
+                if (decoded) {
+                    MTLRegion region = MTLRegionMake2D (0, 0, decW, decH);
+                    [tex replaceRegion:region
+                          mipmapLevel:level
+                            withBytes:decoded
+                          bytesPerRow:static_cast<NSUInteger> (decW) * 4];
+                    stbi_image_free (decoded);
+                } else {
+                    sLog.error ("CTexture::initMetalTexture: mip ", level,
+                                " buffer too small and stbi failed: ", stbi_failure_reason ());
+                }
+            } else {
+                const NSUInteger bytesPerRow = static_cast<NSUInteger> (mipW) * bpp;
+                MTLRegion region = MTLRegionMake2D (0, 0, mipW, mipH);
+                [tex replaceRegion:region
+                      mipmapLevel:level
+                        withBytes:bytes
+                      bytesPerRow:bytesPerRow];
+            }
+        }
+    }
+
+    this->m_metalTexture = (__bridge_retained void*)tex;
+}
+
+void CTexture::destroyMetalTexture () {
+    if (this->m_metalTexture) {
+        (void)(__bridge_transfer id<MTLTexture>)this->m_metalTexture;
+        this->m_metalTexture = nullptr;
+    }
+}
+
+void* CTexture::getMetalTexture () const {
+    if (this->m_player) {
+        if (void* videoTexture = this->m_player->getMetalTexture ()) {
+            return videoTexture;
+        }
+    }
+
+    return this->m_metalTexture;
+}
